---
import Base from '../../layouts/Base.astro';
---

<Base title="搜索" description="按标题、摘要和正文搜索站内文章。">
  <h1 class="page-title">搜索</h1>
  <p class="lede">在顶栏输入关键词，会在标题、摘要和正文里找。</p>
  <p class="search-hint" id="search-hint" aria-live="polite">正在准备索引…</p>
  <div class="post-list" id="search-results"></div>
  <script is:inline>
    window.dorothySearch?.initPage({
      hintEl: '#search-hint',
      resultsEl: '#search-results',
      inputEl: '#site-search-input',
      debounceMs: 300,
    });
  </script>
</Base>

<style>
  .search-hint {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  #search-results {
    margin-top: 1.15rem;
  }

  #search-results :global(.search-hit) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 0.75rem;
  }

  #search-results :global(.search-hit .search-suggest-desc) {
    grid-column: 1 / -1;
    margin-top: 0.15rem;
    line-height: 1.5;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>