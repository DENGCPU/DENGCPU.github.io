---
import { channels } from '../../data/channels';
import Base from '../../layouts/Base.astro';
---

<Base title="新文章" description="在手机上写一篇文章并发布。" noindex>
  <h1 class="page-title">新文章</h1>
  <p class="lede">写完点发布。大约一分钟后，文章会出现在网站上。</p>

  <section class="token" id="token-panel">
    <p id="token-state">还没有连接这台手机。</p>
    <p class="token-help" id="token-help">
      打开
      <a href="https://github.com/settings/tokens/new?scopes=public_repo&description=DorothyJay">GitHub 新建令牌</a>
      ，勾选 <code>public_repo</code>，生成后粘贴到下面。令牌只留在这台手机里。
    </p>
    <label>
      GitHub 令牌
      <input id="token" type="password" autocomplete="off" spellcheck="false" />
    </label>
    <button class="text-button" type="button" id="save-token">保存在这台手机</button>
    <button class="text-button" type="button" id="forget-token" hidden>断开</button>
  </section>

  <section class="private-list" id="private-list" hidden>
    <p>这台手机上的加密文章</p>
    <div id="private-items"></div>
  </section>

  <form class="composer" id="composer" novalidate onsubmit="return false">
    <label>
      标题
      <input name="title" required maxlength="80" />
    </label>
    <label>
      大类
      <select name="channel">
        {channels.map((channel) => <option value={channel.id}>{channel.title}</option>)}
      </select>
    </label>
    <label>
      系列
      <input name="series" placeholder="只有前端学习需要，例如 React" />
    </label>
    <label>
      摘要
      <input name="summary" placeholder="一句话，可以留空" />
    </label>
    <label>
      正文
      <textarea name="content" rows="14"></textarea>
    </label>
    <div id="private-block">
      <label class="check">
        <input id="private-toggle" type="checkbox" />
        仅自己可见
      </label>
      <div id="private-fields" hidden>
        <p>不会出现在首页和文章列表。密码只在打开这篇文章时用，网站不保存。</p>
        <label>
          密码
          <input id="private-password" type="password" autocomplete="new-password" />
        </label>
        <label id="private-confirm-label">
          再输入一次
          <input id="private-password2" type="password" autocomplete="new-password" />
        </label>
        <button class="text-button" type="button" id="open-private" hidden>打开原文</button>
      </div>
    </div>
    <p class="composer-status" id="composer-status" role="status"></p>
    <button class="publish" type="button" id="publish">发布</button>
  </form>
  <script is:inline src="/lock.js"></script>
  <script is:inline>
    const repo = 'DENGCPU/DENGCPU.github.io';
    const owner = 'DENGCPU';
    const tokenKey = 'dorothyjay-github-token';
    const tokenInput = document.querySelector('#token');
    const tokenState = document.querySelector('#token-state');
    const tokenHelp = document.querySelector('#token-help');
    const saveButton = document.querySelector('#save-token');
    const forgetButton = document.querySelector('#forget-token');
    const form = document.querySelector('#composer');
    const status = document.querySelector('#composer-status');
    const publishButton = document.querySelector('#publish');

    const headers = (token) => {
      const result = {
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
      };
      if (token) result.Authorization = 'Bearer ' + token;
      return result;
    };

    function say(message) {
      if (!status) return;
      status.textContent = message;
      status.scrollIntoView({ block: 'nearest' });
    }

    function savedToken() {
      return (localStorage.getItem(tokenKey) || '').trim();
    }

    function showConnected(login) {
      if (tokenState) tokenState.textContent = '已连接 ' + login + '。下次打开可以直接写。';
      if (tokenHelp) tokenHelp.hidden = true;
      if (saveButton) saveButton.hidden = true;
      if (forgetButton) forgetButton.hidden = false;
      if (tokenInput) {
        tokenInput.value = '';
        const label = tokenInput.closest('label');
        if (label) label.hidden = true;
      }
    }

    function showDisconnected() {
      if (tokenState) tokenState.textContent = '还没有连接这台手机。';
      if (tokenHelp) tokenHelp.hidden = false;
      if (saveButton) saveButton.hidden = false;
      if (forgetButton) forgetButton.hidden = true;
      if (tokenInput) {
        const label = tokenInput.closest('label');
        if (label) label.hidden = false;
      }
    }

    async function github(token, path, init) {
      const response = await fetch('https://api.github.com' + path, {
        ...(init || {}),
        headers: { ...headers(token), ...((init && init.headers) || {}) },
      });
      const text = await response.text();
      const data = text ? JSON.parse(text) : {};
      return { response, data };
    }

    async function identify(token) {
      const { response, data } = await github(token, '/user');
      if (!response.ok) throw new Error('这个令牌无效，或已经过期。');
      if (data.login !== owner) throw new Error('这个令牌不是站点主人的。');
      return data.login;
    }

    saveButton?.addEventListener('click', async () => {
      const token = (tokenInput?.value || '').trim();
      if (!token) {
        say('先粘贴令牌。');
        return;
      }
      say('正在连接…');
      try {
        const login = await identify(token);
        localStorage.setItem(tokenKey, token);
        showConnected(login);
        if (editId && !fileSha) await loadPost();
        else if (!editId) say('已保存在这台手机。');
      } catch (error) {
        say(error instanceof Error ? error.message : '没有连上。');
      }
    });

    forgetButton?.addEventListener('click', () => {
      localStorage.removeItem(tokenKey);
      showDisconnected();
      say('已从这台手机断开。');
    });

    const privateListKey = 'dorothyjay-private-posts';
    const datedPost = /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}\/[^/]+$/;
    const lockedPost = /^private\/[a-f0-9]{16}$/;
    const editId = new URLSearchParams(location.search).get('post') || '';
    const privateToggle = document.querySelector('#private-toggle');
    const privateFields = document.querySelector('#private-fields');
    const privateBlock = document.querySelector('#private-block');
    let fileSha = '';
    let originalDate = '';
    let isPrivatePost = false;
    let cipherText = '';
    let privatePassword = '';
    let publishedDay = '';

    function editable(id) {
      return datedPost.test(id) || lockedPost.test(id);
    }

    if (editId && !editable(editId)) {
      say('这篇文章的地址不对。');
    } else if (editId) {
      const heading = document.querySelector('h1');
      const lede = document.querySelector('.lede');
      if (heading) heading.textContent = '修改文章';
      if (lede) lede.textContent = '改完点保存。大约一分钟后，网站上会换成新的内容。网址不变。';
      if (publishButton) publishButton.textContent = '保存';
      document.title = '修改文章 · DorothyJay';
      if (datedPost.test(editId) && privateBlock) privateBlock.hidden = true;
    }

    privateToggle?.addEventListener('change', () => {
      if (isPrivatePost) {
        privateToggle.checked = true;
        return;
      }
      if (privateFields) privateFields.hidden = !privateToggle.checked;
    });

    document.querySelector('#open-private')?.addEventListener('click', async () => {
      const password = document.querySelector('#private-password')?.value || '';
      if (!password) {
        say('先输入密码。');
        return;
      }
      if (!window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      say('正在打开…');
      try {
        const payload = await window.dorothyLock.decryptPayload(password, cipherText);
        privatePassword = password;
        form.querySelector('[name="title"]').value = payload.title || '';
        if (payload.channel) form.querySelector('[name="channel"]').value = payload.channel;
        form.querySelector('[name="series"]').value = payload.series || '';
        form.querySelector('[name="summary"]').value = payload.summary || '';
        form.querySelector('[name="content"]').value = payload.content || '';
        if (publishButton) publishButton.disabled = false;
        if (privateFields) privateFields.hidden = true;
        say('已打开。改完点保存，仍用这个密码。');
      } catch (error) {
        say(error instanceof Error ? error.message : '密码不对。');
      }
    });

    async function loadPost() {
      if (!editId) return;
      say('正在读取原文…');
      const filePath = 'src/content/posts/' + editId + '.md';
      const apiPath = '/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/');
      let result = await github('', apiPath);
      if (!result.response.ok && savedToken()) result = await github(savedToken(), apiPath);
      if (!result.response.ok) throw new Error('没有读到这篇文章。');
      const data = result.data;
      fileSha = data.sha;
      const markdown = data.content ? base64ToUtf8(data.content) : await (await fetch(data.download_url)).text();
      const parsed = parseFrontmatter(markdown);
      originalDate = parsed.data.date || '';
      if (parsed.data.private === 'true') {
        isPrivatePost = true;
        cipherText = parsed.body.trim();
        if (privateToggle) {
          privateToggle.checked = true;
          privateToggle.disabled = true;
        }
        if (privateFields) privateFields.hidden = false;
        const confirmLabel = document.querySelector('#private-confirm-label');
        const openButton = document.querySelector('#open-private');
        if (confirmLabel) confirmLabel.hidden = true;
        if (openButton) openButton.hidden = false;
        if (publishButton) publishButton.disabled = true;
        say('输入密码，打开原文后再改。');
        return;
      }
      form.querySelector('[name="title"]').value = parsed.data.title || '';
      if (parsed.data.channel) form.querySelector('[name="channel"]').value = parsed.data.channel;
      form.querySelector('[name="series"]').value = parsed.data.series || '';
      form.querySelector('[name="summary"]').value = parsed.data.summary || '';
      form.querySelector('[name="content"]').value = parsed.body.replace(/^\n/, '').replace(/\n$/, '');
      say('');
    }

    if (editId && editable(editId)) {
      loadPost().catch((error) => {
        say(error instanceof Error ? error.message : '没有读到这篇文章。');
      });
    }

    if (savedToken()) {
      identify(savedToken())
        .then(showConnected)
        .catch(() => {
          localStorage.removeItem(tokenKey);
          showDisconnected();
        });
    }

    publishButton?.addEventListener('click', async () => {
      const typed = (tokenInput?.value || '').trim();
      const token = typed || savedToken();
      if (!token) {
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      const data = new FormData(form);
      const title = String(data.get('title') || '').trim();
      const channel = String(data.get('channel') || '');
      const series = String(data.get('series') || '').trim();
      const summary = String(data.get('summary') || '').trim();
      const content = String(data.get('content') || '').trim();
      if (!title || !content) {
        say('标题和正文都要写。');
        return;
      }
      const wantsPrivate = isPrivatePost || (!editId && Boolean(privateToggle?.checked));
      let password = privatePassword;
      if (wantsPrivate && !editId) {
        const first = document.querySelector('#private-password')?.value || '';
        const second = document.querySelector('#private-password2')?.value || '';
        if (first.length < 8) {
          say('密码至少 8 位。');
          return;
        }
        if (first !== second) {
          say('两次密码不一致。');
          return;
        }
        password = first;
      }
      if (wantsPrivate && !password) {
        say('先输入密码，打开原文。');
        return;
      }
      if (wantsPrivate && !window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      publishButton.disabled = true;
      say(editId ? '正在保存…' : '正在发布…');
      try {
        localStorage.setItem(tokenKey, token);
        await identify(token);
        const post = { title, channel, series, summary, content };
        const filePath = editId
          ? await updatePost(token, post, wantsPrivate ? password : '')
          : wantsPrivate
            ? await createPrivatePost(token, post, password)
            : await createPost(token, post);
        const id = filePath.replace(/^src\/content\/posts\//, '').replace(/\.md$/, '');
        const url = 'https://dengcpu.github.io/' + id + '/';
        if (wantsPrivate) rememberPrivate({ id, title, date: publishedDay || originalDate.slice(0, 10) });
        status.textContent = '';
        status.append(
          (editId ? '已保存。大约一分钟后打开：' : '已发布。大约一分钟后打开：') +
            (wantsPrivate ? '它不会出现在首页和文章列表里。' : ''),
          Object.assign(document.createElement('a'), { href: url, textContent: url }),
        );
        if (!editId) {
          form.reset();
          if (privateFields) privateFields.hidden = true;
          showConnected(owner);
        }
      } catch (error) {
        say(error instanceof Error ? error.message : '没有发布。');
      } finally {
        publishButton.disabled = isPrivatePost && !privatePassword;
      }
    });

    async function createPost(token, post) {
      const stamp = shanghaiStamp();
      const parts = stamp.day.split('-');
      const base = 'src/content/posts/' + parts[0] + '/' + parts[1] + '/' + parts[2] + '/' + safeName(post.title);
      const markdown = render({ ...post, iso: stamp.iso });
      for (let index = 1; index <= 5; index += 1) {
        const filePath = index === 1 ? base + '.md' : base + '-' + index + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add post: ' + post.title,
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) return filePath;
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('同名文章太多，换一个标题再试。');
    }

    async function createPrivatePost(token, post, password) {
      const stamp = shanghaiStamp();
      const envelope = await window.dorothyLock.encryptPayload(password, { ...post, date: stamp.iso });
      const markdown = renderPrivate(stamp.iso, envelope);
      for (let attempt = 0; attempt < 3; attempt += 1) {
        const filePath = 'src/content/posts/private/' + randomId() + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add private post',
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) {
          publishedDay = stamp.day;
          return filePath;
        }
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('没有发布。');
    }

    async function updatePost(token, post, password) {
      const filePath = 'src/content/posts/' + editId + '.md';
      const iso = originalDate || shanghaiStamp().iso;
      const markdown = password
        ? renderPrivate(iso, await window.dorothyLock.encryptPayload(password, { ...post, date: iso }))
        : render({ ...post, iso });
      const response = await fetch(
        'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
        {
          method: 'PUT',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: password ? 'Update private post' : 'Update post: ' + post.title,
            content: utf8ToBase64(markdown),
            sha: fileSha,
            branch: 'master',
          }),
        },
      );
      if (response.ok) {
        const data = await response.json();
        fileSha = data.content && data.content.sha ? data.content.sha : fileSha;
        return filePath;
      }
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
      if (response.status === 409 || response.status === 422) throw new Error('文章刚被改过，请重新打开这一页再保存。');
      throw new Error('没有保存。');
    }

    function parseFrontmatter(markdown) {
      if (!markdown.startsWith('---\n')) throw new Error('这篇文件缺少开头信息。');
      const end = markdown.indexOf('\n---\n', 4);
      if (end === -1) throw new Error('这篇文件缺少开头信息。');
      const data = {};
      markdown.slice(4, end).split('\n').forEach((line) => {
        const index = line.indexOf(':');
        if (index === -1) return;
        const key = line.slice(0, index).trim();
        let value = line.slice(index + 1).trim();
        if (value.startsWith('"') && value.endsWith('"')) {
          value = value.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, '\\');
        }
        data[key] = value;
      });
      return { data, body: markdown.slice(end + 5) };
    }

    function base64ToUtf8(value) {
      const binary = atob(value.replace(/\n/g, ''));
      const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }

    function renderPrivate(iso, envelope) {
      return ['---', 'title: "private"', 'date: ' + iso, 'channel: other', 'private: true', '---', '', envelope, ''].join('\n');
    }

    function randomId() {
      const bytes = crypto.getRandomValues(new Uint8Array(8));
      return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    }

    function readPrivateList() {
      try {
        const parsed = JSON.parse(localStorage.getItem(privateListKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        return [];
      }
    }

    function rememberPrivate(entry) {
      const next = [entry, ...readPrivateList().filter((item) => item.id !== entry.id)].slice(0, 40);
      localStorage.setItem(privateListKey, JSON.stringify(next));
      renderPrivateList();
    }

    function renderPrivateList() {
      const section = document.querySelector('#private-list');
      const items = document.querySelector('#private-items');
      if (!section || !items) return;
      const list = readPrivateList();
      items.replaceChildren();
      if (!list.length) {
        section.hidden = true;
        return;
      }
      section.hidden = false;
      const ul = document.createElement('ul');
      list.forEach((entry) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = '/' + entry.id + '/';
        link.textContent = entry.title || '加密文章';
        const edit = document.createElement('a');
        edit.href = '/write/?post=' + encodeURIComponent(entry.id);
        edit.textContent = '修改';
        li.append(link, edit);
        ul.append(li);
      });
      items.append(ul);
    }

    renderPrivateList();

    function render(post) {
      const lines = ['---', 'title: ' + yamlString(post.title), 'date: ' + post.iso, 'channel: ' + post.channel];
      if (post.series) lines.push('series: ' + yamlString(post.series));
      if (post.summary) lines.push('summary: ' + yamlString(post.summary));
      lines.push('---', '', post.content, '');
      return lines.join('\n');
    }

    function yamlString(value) {
      return '"' + value.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ') + '"';
    }

    function safeName(value) {
      const name = value.replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, ' ').trim().replace(/^\.+/g, '').slice(0, 80).trim();
      if (!name) throw new Error('标题不能作为文件名。');
      return name;
    }

    function utf8ToBase64(value) {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return btoa(binary);
    }

    function shanghaiStamp(date) {
      const text = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Shanghai',
        hourCycle: 'h23',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      }).format(date || new Date());
      const parts = text.split(' ');
      return { day: parts[0], iso: parts[0] + 'T' + parts[1] };
    }
  </script>
</Base>


<style>
  .token,
  .composer {
    max-width: 42rem;
  }

  .token {
    margin-top: 2rem;
    padding-top: 0.2rem;
  }

  .token p,
  .token-help {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .token a,
  .composer-status a {
    color: var(--accent);
  }

  .composer label,
  .token label {
    display: block;
    margin-top: 1.15rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .composer input,
  .composer select,
  .composer textarea,
  .token input {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    line-height: 1.6;
    padding: 0.35rem 0;
  }

  .composer textarea {
    min-height: 16rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    resize: vertical;
  }

  .composer select {
    appearance: none;
  }

  .text-button,
  .publish {
    margin-top: 1.1rem;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    padding: 0;
  }

  .publish {
    color: var(--bg);
    background: var(--ink);
    border-radius: 999px;
    padding: 0.35rem 1rem;
  }

  .publish:disabled {
    opacity: 0.55;
  }

  .composer-status {
    min-height: 1.6em;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .composer-status a {
    display: inline;
    overflow-wrap: anywhere;
  }

  .composer label.check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.4rem;
    color: var(--ink);
  }

  .composer label.check input {
    width: 1rem;
    height: 1rem;
    margin: 0;
  }

  #private-fields p {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .private-list {
    max-width: 42rem;
    margin-top: 2rem;
  }

  .private-list p {
    margin: 0;
    color: var(--muted);
  }

  .private-list ul {
    margin: 0.6rem 0 0;
