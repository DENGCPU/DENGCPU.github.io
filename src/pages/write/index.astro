---
import { channels } from '../../data/channels';
import Base from '../../layouts/Base.astro';
---

<Base title="新文章" description="在手机上写一篇文章并发布。" noindex>
  <h1 class="page-title">新文章</h1>
  <p class="lede">写完点发布。大约一分钟后，文章会出现在网站上。</p>

  <section class="token" id="token-panel">
    <p id="token-state">还没有连接这台手机。</p>
    <p class="token-help" id="token-help">
      打开
      <a href="https://github.com/settings/tokens/new?scopes=public_repo&description=DorothyJay">GitHub 新建令牌</a>
      ，勾选 <code>public_repo</code>，生成后粘贴到下面。令牌只留在这台手机里。
    </p>
    <label>
      GitHub 令牌
      <input id="token" type="password" autocomplete="off" spellcheck="false" />
    </label>
    <button class="text-button" type="button" id="save-token">保存在这台手机</button>
    <button class="text-button" type="button" id="forget-token" hidden>断开</button>
  </section>

  <form class="composer" id="composer">
    <label>
      标题
      <input name="title" required maxlength="80" />
    </label>
    <label>
      大类
      <select name="channel">
        {channels.map((channel) => <option value={channel.id}>{channel.title}</option>)}
      </select>
    </label>
    <label>
      系列
      <input name="series" placeholder="只有前端学习需要，例如 React" />
    </label>
    <label>
      摘要
      <input name="summary" placeholder="一句话，可以留空" />
    </label>
    <label>
      正文
      <textarea name="content" required rows="14"></textarea>
    </label>
    <button class="publish" type="submit">发布</button>
  </form>
  <p class="composer-status" id="composer-status" role="status"></p>
</Base>

<script>
  const repo = 'DENGCPU/DENGCPU.github.io';
  const owner = 'DENGCPU';
  const tokenKey = 'dorothyjay-github-token';
  const tokenInput = document.querySelector<HTMLInputElement>('#token');
  const tokenState = document.querySelector<HTMLElement>('#token-state');
  const tokenHelp = document.querySelector<HTMLElement>('#token-help');
  const saveButton = document.querySelector<HTMLButtonElement>('#save-token');
  const forgetButton = document.querySelector<HTMLButtonElement>('#forget-token');
  const form = document.querySelector<HTMLFormElement>('#composer');
  const status = document.querySelector<HTMLElement>('#composer-status');
  const publishButton = form?.querySelector<HTMLButtonElement>('button.publish');

  const headers = (token: string) => ({
    Authorization: `Bearer ${token}`,
    Accept: 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
  });

  function say(message: string) {
    if (status) status.textContent = message;
  }

  function savedToken() {
    return localStorage.getItem(tokenKey)?.trim() ?? '';
  }

  function showConnected(login: string) {
    if (tokenState) tokenState.textContent = `已连接 ${login}。下次打开可以直接写。`;
    tokenHelp?.setAttribute('hidden', '');
    saveButton?.setAttribute('hidden', '');
    forgetButton?.removeAttribute('hidden');
    if (tokenInput) tokenInput.value = '';
    tokenInput?.closest('label')?.setAttribute('hidden', '');
  }

  function showDisconnected() {
    if (tokenState) tokenState.textContent = '还没有连接这台手机。';
    tokenHelp?.removeAttribute('hidden');
    saveButton?.removeAttribute('hidden');
    forgetButton?.setAttribute('hidden', '');
    tokenInput?.closest('label')?.removeAttribute('hidden');
  }

  async function github(token: string, path: string, init?: RequestInit) {
    const response = await fetch(`https://api.github.com${path}`, {
      ...init,
      headers: { ...headers(token), ...(init?.headers ?? {}) },
    });
    const text = await response.text();
    const data = text ? JSON.parse(text) : {};
    return { response, data };
  }

  async function identify(token: string) {
    const { response, data } = await github(token, '/user');
    if (!response.ok) throw new Error('这个令牌无效，或已经过期。');
    if (data.login !== owner) throw new Error('这个令牌不是站点主人的。');
    return data.login as string;
  }

  saveButton?.addEventListener('click', async () => {
    const token = tokenInput?.value.trim() ?? '';
    if (!token) {
      say('先粘贴令牌。');
      return;
    }
    say('正在连接…');
    try {
      const login = await identify(token);
      localStorage.setItem(tokenKey, token);
      showConnected(login);
      say('');
    } catch (error) {
      say(error instanceof Error ? error.message : '没有连上。');
    }
  });

  forgetButton?.addEventListener('click', () => {
    localStorage.removeItem(tokenKey);
    showDisconnected();
    say('已从这台手机断开。');
  });

  if (savedToken()) {
    identify(savedToken())
      .then(showConnected)
      .catch(() => {
        localStorage.removeItem(tokenKey);
        showDisconnected();
      });
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const token = savedToken();
    if (!token) {
      say('先把 GitHub 令牌保存在这台手机上。');
      return;
    }
    const data = new FormData(form);
    const title = String(data.get('title') ?? '').trim();
    const channel = String(data.get('channel') ?? '');
    const series = String(data.get('series') ?? '').trim();
    const summary = String(data.get('summary') ?? '').trim();
    const content = String(data.get('content') ?? '').trim();
    if (!title || !content) {
      say('标题和正文都要写。');
      return;
    }
    if (publishButton) publishButton.disabled = true;
    say('正在发布…');
    try {
      await identify(token);
      const filePath = await createPost(token, { title, channel, series, summary, content });
      const url = `https://dengcpu.github.io/${filePath.replace(/^src\/content\/posts\//, '').replace(/\.md$/, '')}/`;
      say('');
      if (status) {
        status.replaceChildren(
          document.createTextNode('已发布。大约一分钟后打开：'),
          Object.assign(document.createElement('a'), { href: url, textContent: url }),
        );
      }
      form.reset();
    } catch (error) {
      say(error instanceof Error ? error.message : '没有发布。');
    } finally {
      if (publishButton) publishButton.disabled = false;
    }
  });

  async function createPost(
    token: string,
    post: { title: string; channel: string; series: string; summary: string; content: string },
  ) {
    const stamp = shanghaiStamp();
    const [year, month, day] = stamp.day.split('-');
    const base = `src/content/posts/${year}/${month}/${day}/${safeName(post.title)}`;
    const markdown = render({ ...post, iso: stamp.iso });
    for (let index = 1; index <= 5; index += 1) {
      const filePath = index === 1 ? `${base}.md` : `${base}-${index}.md`;
      const response = await fetch(
        `https://api.github.com/repos/${repo}/contents/${filePath.split('/').map(encodeURIComponent).join('/')}`,
        {
          method: 'PUT',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: `Add post: ${post.title}`,
            content: utf8ToBase64(markdown),
            branch: 'master',
          }),
        },
      );
      if (response.ok) return filePath;
      if (response.status === 422 || response.status === 409) continue;
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。');
      throw new Error('发布没有成功。');
    }
    throw new Error('同名文章太多，换一个标题再试。');
  }

  function render(post: { title: string; channel: string; series: string; summary: string; content: string; iso: string }) {
    const lines = ['---', `title: ${yamlString(post.title)}`, `date: ${post.iso}`, `channel: ${post.channel}`];
    if (post.series) lines.push(`series: ${yamlString(post.series)}`);
    if (post.summary) lines.push(`summary: ${yamlString(post.summary)}`);
    lines.push('---', '', post.content, '');
    return lines.join('\n');
  }

  function yamlString(value: string) {
    return `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ')}"`;
  }

  function safeName(value: string) {
    const name = value.replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, ' ').trim().replace(/^\.+/g, '').slice(0, 80).trim();
    if (!name) throw new Error('标题不能作为文件名。');
    return name;
  }

  function utf8ToBase64(value: string) {
    const bytes = new TextEncoder().encode(value);
    let binary = '';
    bytes.forEach((byte) => {
      binary += String.fromCharCode(byte);
    });
    return btoa(binary);
  }

  function shanghaiStamp(date = new Date()) {
    const text = new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Asia/Shanghai',
      hourCycle: 'h23',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    }).format(date);
    const [day, time] = text.split(' ');
    return { day, iso: `${day}T${time}` };
  }
</script>

<style>
  .token,
  .composer {
    max-width: 42rem;
  }

  .token {
    margin-top: 2rem;
    padding-top: 0.2rem;
  }

  .token p,
  .token-help {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .token a,
  .composer-status a {
    color: var(--accent);
  }

  .composer label,
  .token label {
    display: block;
    margin-top: 1.15rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .composer input,
  .composer select,
  .composer textarea,
  .token input {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    line-height: 1.6;
    padding: 0.35rem 0;
  }

  .composer textarea {
    min-height: 16rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    resize: vertical;
  }

  .composer select {
    appearance: none;
  }

  .text-button,
  .publish {
    margin-top: 1.1rem;
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    padding: 0;
  }

  .publish {
    color: var(--bg);
    background: var(--ink);
    border-radius: 999px;
    padding: 0.35rem 1rem;
  }

  .publish:disabled {
    opacity: 0.55;
  }

  .composer-status {
    min-height: 1.6em;
    margin: 1rem 0 0;
    color: var(--muted);
  }

  .composer-status a {
    display: inline;
    overflow-wrap: anywhere;
  }
</style>
