---
import { channels } from '../../data/channels';
import Base from '../../layouts/Base.astro';
---

<Base title="新文章" description="在手机上写一篇文章并发布。" noindex>
  <h1 class="page-title">新文章</h1>
  <p class="lede">写完点发布。大约一分钟后，文章会出现在网站上。</p>

  <section class="token" id="token-panel">
    <p id="token-state">还没有连接这台手机。</p>
    <p class="token-help" id="token-help">
      打开
      <a href="https://github.com/settings/tokens/new?scopes=public_repo&description=DorothyJane">GitHub 新建令牌</a>
      ，勾选 <code>public_repo</code>，生成后粘贴到下面。令牌只留在这台手机里。
    </p>
    <label>
      GitHub 令牌
      <input id="token" type="password" autocomplete="off" spellcheck="false" />
    </label>
    <button class="text-button" type="button" id="save-token">保存在这台手机</button>
    <button class="text-button" type="button" id="forget-token" hidden>断开</button>
  </section>

  <section class="private-list" id="private-list" hidden>
    <p id="private-list-label">这台手机上的加密文章</p>
    <div id="private-items"></div>
  </section>

  <form class="composer" id="composer" novalidate onsubmit="return false">
    <label>
      标题
      <input name="title" required maxlength="80" />
    </label>
    <label>
      大类
      <select name="channel">
        {channels.map((channel) => <option value={channel.id}>{channel.title}</option>)}
      </select>
    </label>
    <label>
      系列
      <input name="series" placeholder="只有前端学习需要，例如 React" />
    </label>
    <label>
      摘要
      <input name="summary" placeholder="一句话，可以留空" />
    </label>
    <div class="editor-field">
      <p class="field-name">正文</p>
      <div class="md-draft-banner" id="md-draft-banner" hidden role="status">
        <p id="md-draft-banner-text">这台手机上有未发布的草稿。</p>
        <div class="md-draft-banner-actions">
          <button type="button" class="text-button" id="md-draft-restore">恢复草稿</button>
          <button type="button" class="text-button" id="md-draft-dismiss">丢弃</button>
        </div>
      </div>
      <div class="md-editor" id="md-editor">
        <div class="md-bar" role="toolbar" aria-label="正文格式">
          <div class="md-mode" role="group" aria-label="编写或预览">
            <button type="button" class="md-mode-btn is-active" id="md-mode-write" aria-pressed="true">编写</button>
            <button type="button" class="md-mode-btn" id="md-mode-preview" aria-pressed="false">预览</button>
          </div>
          <span class="md-gap"></span>
          <div class="md-tools" id="md-tools">
            <button type="button" data-md="h2" aria-label="二级标题">H2</button>
            <button type="button" data-md="h3" aria-label="三级标题">H3</button>
            <button type="button" data-md="bold" aria-label="加粗"><b>B</b></button>
            <button type="button" data-md="italic" aria-label="斜体"><i>I</i></button>
            <button type="button" data-md="ul" aria-label="无序列表" title="无序列表">•</button>
            <button type="button" data-md="quote" aria-label="引用">引</button>
            <button type="button" data-md="code" aria-label="代码块">码</button>
            <button type="button" data-md="link" aria-label="链接">链</button>
            <button type="button" id="md-upload" aria-label="从相册上传图片">相册</button>
            <button type="button" id="md-image-url" aria-label="粘贴图片地址">图址</button>
          </div>
        </div>
        <div class="md-pop" id="md-pop" hidden>
          <p class="md-pop-label" id="md-pop-label">链接地址</p>
          <input id="md-pop-input" type="text" inputmode="url" autocomplete="off" placeholder="https://" />
          <button type="button" id="md-pop-ok">插入</button>
          <button type="button" id="md-pop-unlink" hidden>去掉链接</button>
          <button type="button" id="md-pop-cancel">取消</button>
        </div>
        <textarea class="md-source" name="content" id="md-content" rows="14" placeholder="开始写，支持 Markdown…" spellcheck="true"></textarea>
        <div id="md-preview" class="md-preview" hidden tabindex="-1" aria-label="预览"></div>
        <input id="md-file" type="file" accept="image/*" hidden />
        <div class="md-foot">
          <span id="md-draft-hint" class="md-draft-hint" hidden></span>
          <span id="md-count">0</span> 字
        </div>
      </div>
    </div>
    <div id="private-block">
      <label class="check">
        <input id="private-toggle" type="checkbox" />
        加密正文
      </label>
      <div id="private-fields" hidden>
        <p>标题和分类会出现在文章列表里，并标成加密。正文要密码才能看，网站不保存密码。改已经发出去的文章时，网址和分类不变。</p>
        <label>
          密码
          <input id="private-password" type="password" autocomplete="new-password" />
        </label>
        <label id="private-confirm-label">
          再输入一次
          <input id="private-password2" type="password" autocomplete="new-password" />
        </label>
        <button class="text-button" type="button" id="open-private" hidden>打开原文</button>
      </div>
    </div>
    <p class="composer-status" id="composer-status" role="status"></p>
    <div class="composer-actions">
      <button class="publish" type="button" id="publish">发布</button>
      <button class="text-button" type="button" id="delete-post" hidden>删除</button>
    </div>
  </form>
  <dialog class="delete-dialog" id="delete-dialog">
    <h2>删除这篇文章？</h2>
    <p id="delete-copy"></p>
    <div class="dialog-actions">
      <button type="button" id="delete-cancel">取消</button>
      <button class="danger" type="button" id="delete-confirm">确认删除</button>
    </div>
  </dialog>
  <script is:inline src="/vendor/markdown-it.js"></script>
  <script is:inline src="/markdown-headings.js"></script>
  <script is:inline src="/lock.js"></script>
  <script is:inline>
    const repo = 'DENGCPU/DENGCPU.github.io';
    const owner = 'DENGCPU';
    const tokenKey = 'dorothyjay-github-token';
    const tokenInput = document.querySelector('#token');
    const tokenState = document.querySelector('#token-state');
    const tokenHelp = document.querySelector('#token-help');
    const saveButton = document.querySelector('#save-token');
    const forgetButton = document.querySelector('#forget-token');
    const form = document.querySelector('#composer');
    const status = document.querySelector('#composer-status');
    const publishButton = document.querySelector('#publish');
    const deleteButton = document.querySelector('#delete-post');
    const deleteDialog = document.querySelector('#delete-dialog');
    const deleteCopy = document.querySelector('#delete-copy');
    const deleteConfirm = document.querySelector('#delete-confirm');

    const headers = (token) => {
      const result = {
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
      };
      if (token) result.Authorization = 'Bearer ' + token;
      return result;
    };

    function say(message) {
      if (!status) return;
      status.textContent = message;
      status.scrollIntoView({ block: 'nearest' });
    }

    function savedToken() {
      return (localStorage.getItem(tokenKey) || '').trim();
    }

    function showConnected(login) {
      if (tokenState) tokenState.textContent = '已连接 ' + login + '。下次打开可以直接写。';
      if (tokenHelp) tokenHelp.hidden = true;
      if (saveButton) saveButton.hidden = true;
      if (forgetButton) forgetButton.hidden = false;
      if (tokenInput) {
        tokenInput.value = '';
        const label = tokenInput.closest('label');
        if (label) label.hidden = true;
      }
    }

    function showDisconnected() {
      if (tokenState) tokenState.textContent = '还没有连接这台手机。';
      if (tokenHelp) tokenHelp.hidden = false;
      if (saveButton) saveButton.hidden = false;
      if (forgetButton) forgetButton.hidden = true;
      if (tokenInput) {
        const label = tokenInput.closest('label');
        if (label) label.hidden = false;
      }
    }

    async function github(token, path, init) {
      const response = await fetch('https://api.github.com' + path, {
        ...(init || {}),
        headers: { ...headers(token), ...((init && init.headers) || {}) },
      });
      const text = await response.text();
      const data = text ? JSON.parse(text) : {};
      return { response, data };
    }

    async function identify(token) {
      const { response, data } = await github(token, '/user');
      if (!response.ok) throw new Error('这个令牌无效，或已经过期。');
      if (data.login !== owner) throw new Error('这个令牌不是站点主人的。');
      return data.login;
    }

    saveButton?.addEventListener('click', async () => {
      const token = (tokenInput?.value || '').trim();
      if (!token) {
        say('先粘贴令牌。');
        return;
      }
      say('正在连接…');
      try {
        const login = await identify(token);
        localStorage.setItem(tokenKey, token);
        window.dorothyAuthor?.markAuthor();
        showConnected(login);
        refreshPrivateList();
        if (editId && !fileSha) await loadPost();
        else if (!editId) say('已保存在这台手机。');
      } catch (error) {
        say(error instanceof Error ? error.message : '没有连上。');
      }
    });

    forgetButton?.addEventListener('click', () => {
      localStorage.removeItem(tokenKey);
      showDisconnected();
      say('已从这台手机断开。');
    });

    const privateListKey = 'dorothyjay-private-posts';
    const datedPost = /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}\/[^/]+$/;
    const lockedPost = /^private\/[a-f0-9]{16}$/;
    const editId = new URLSearchParams(location.search).get('post') || '';
    const privateToggle = document.querySelector('#private-toggle');
    const privateFields = document.querySelector('#private-fields');
    let fileSha = '';
    let originalDate = '';
    let isPrivatePost = false;
    let removed = false;
    let cipherText = '';
    let privatePassword = '';
    let publishedDay = '';

    function editable(id) {
      return datedPost.test(id) || lockedPost.test(id);
    }

    if (editId && !editable(editId)) {
      say('这篇文章的地址不对。');
    } else if (editId) {
      const heading = document.querySelector('h1');
      const lede = document.querySelector('.lede');
      if (heading) heading.textContent = '修改文章';
      if (lede) lede.textContent = '改完点保存。大约一分钟后，网站上会换成新的内容。网址不变。';
      if (publishButton) publishButton.textContent = '保存';
      if (deleteButton) deleteButton.hidden = false;
      document.title = '修改文章 · DorothyJane';
    }

    privateToggle?.addEventListener('change', () => {
      if (isPrivatePost) {
        privateToggle.checked = true;
        return;
      }
      if (privateFields) privateFields.hidden = !privateToggle.checked;
    });

    document.querySelector('#open-private')?.addEventListener('click', async () => {
      const password = document.querySelector('#private-password')?.value || '';
      if (!password) {
        say('先输入密码。');
        return;
      }
      if (!window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      say('正在打开…');
      try {
        const payload = await window.dorothyLock.decryptPayload(password, cipherText);
        window.dorothyAuthor?.markAuthor();
        privatePassword = password;
        rememberPrivate({
          id: editId,
          title: payload.title || '',
          date: String(payload.date || originalDate || '').slice(0, 10),
          channel: payload.channel || '',
          series: payload.series || '',
        });
        form.querySelector('[name="title"]').value = payload.title || '';
        if (payload.channel) form.querySelector('[name="channel"]').value = payload.channel;
        form.querySelector('[name="series"]').value = payload.series || '';
        form.querySelector('[name="summary"]').value = payload.summary || '';
        setEditorMarkdown(payload.content || '');
        if (publishButton) publishButton.disabled = false;
        if (privateFields) privateFields.hidden = true;
        say('已打开。改完点保存，仍用这个密码。');
      } catch (error) {
        say(error instanceof Error ? error.message : '密码不对。');
      }
    });

    async function loadPost() {
      if (!editId) return;
      say('正在读取原文…');
      const filePath = 'src/content/posts/' + editId + '.md';
      const apiPath = '/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/');
      let result = await github('', apiPath);
      if (!result.response.ok && savedToken()) result = await github(savedToken(), apiPath);
      if (!result.response.ok) throw new Error('没有读到这篇文章。');
      const data = result.data;
      fileSha = data.sha;
      const markdown = data.content ? base64ToUtf8(data.content) : await (await fetch(data.download_url)).text();
      const parsed = parseFrontmatter(markdown);
      originalDate = parsed.data.date || '';
      if (parsed.data.private === 'true') {
        isPrivatePost = true;
        cipherText = parsed.body.trim();
        if (privateToggle) {
          privateToggle.checked = true;
          privateToggle.disabled = true;
        }
        if (privateFields) privateFields.hidden = false;
        const confirmLabel = document.querySelector('#private-confirm-label');
        const openButton = document.querySelector('#open-private');
        if (confirmLabel) confirmLabel.hidden = true;
        if (openButton) openButton.hidden = false;
        if (publishButton) publishButton.disabled = true;
        const knownTitle = parsed.data.title && parsed.data.title !== 'private';
        if (knownTitle) {
          form.querySelector('[name="title"]').value = parsed.data.title;
          if (parsed.data.channel) form.querySelector('[name="channel"]').value = parsed.data.channel;
          form.querySelector('[name="series"]').value = parsed.data.series || '';
          form.querySelector('[name="summary"]').value = parsed.data.summary || '';
        }
        say(knownTitle ? '标题已经在。输入密码后才能改正文。' : '输入密码，打开原文后再改。');
        return;
      }
      form.querySelector('[name="title"]').value = parsed.data.title || '';
      if (parsed.data.channel) form.querySelector('[name="channel"]').value = parsed.data.channel;
      form.querySelector('[name="series"]').value = parsed.data.series || '';
      form.querySelector('[name="summary"]').value = parsed.data.summary || '';
      setEditorMarkdown(parsed.body.replace(/^\n/, '').replace(/\n$/, ''));
      postLoaded = true;
      maybeRestoreDraft();
      say('');
    }

    if (editId && editable(editId)) {
      loadPost().catch((error) => {
        say(error instanceof Error ? error.message : '没有读到这篇文章。');
      });
    }

    if (savedToken()) {
      identify(savedToken())
        .then(showConnected)
        .catch(() => {
          localStorage.removeItem(tokenKey);
          showDisconnected();
        });
    }

    publishButton?.addEventListener('click', async () => {
      const typed = (tokenInput?.value || '').trim();
      const token = typed || savedToken();
      if (!token) {
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      const data = new FormData(form);
      const title = String(data.get('title') || '').trim();
      const channel = String(data.get('channel') || '');
      const series = String(data.get('series') || '').trim();
      const summary = String(data.get('summary') || '').trim();
      let content = String(data.get('content') || '').trim();
      content = normalizeHeadingsForRender(content);
      if (!title || !content) {
        say('标题和正文都要写。');
        return;
      }
      const turningPrivate = !isPrivatePost && Boolean(privateToggle?.checked);
      const wantsPrivate = isPrivatePost || turningPrivate;
      let password = privatePassword;
      if (turningPrivate) {
        const first = document.querySelector('#private-password')?.value || '';
        const second = document.querySelector('#private-password2')?.value || '';
        if (first.length < 8) {
          say('密码至少 8 位。');
          return;
        }
        if (first !== second) {
          say('两次密码不一致。');
          return;
        }
        password = first;
      }
      if (wantsPrivate && !password) {
        say('先输入密码，打开原文。');
        return;
      }
      if (wantsPrivate && !window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      publishButton.disabled = true;
      say(editId ? '正在保存…' : '正在发布…');
      try {
        localStorage.setItem(tokenKey, token);
        window.dorothyAuthor?.markAuthor();
        await identify(token);
        const post = { title, channel, series, summary, content };
        const filePath = editId
          ? await updatePost(token, post, wantsPrivate ? password : '')
          : wantsPrivate
            ? await createPrivatePost(token, post, password)
            : await createPost(token, post);
        const id = filePath.replace(/^src\/content\/posts\//, '').replace(/\.md$/, '');
        const url = 'https://dengcpu.github.io/' + id + '/';
        if (wantsPrivate) {
          rememberPrivate({ id, title, date: publishedDay || originalDate.slice(0, 10), channel, series });
          refreshPrivateList();
        }
        if (editId && turningPrivate) {
          isPrivatePost = true;
          privatePassword = password;
          if (privateToggle) {
            privateToggle.checked = true;
            privateToggle.disabled = true;
          }
        }
        status.textContent = '';
        status.append(
          (editId ? '已保存。大约一分钟后打开：' : '已发布。大约一分钟后打开：') +
            (wantsPrivate ? (editId ? '网址和分类不变，打开需要密码。' : '它会出现在所选分类里，打开需要密码。') : ''),
          Object.assign(document.createElement('a'), { href: url, textContent: url }),
        );
        if (!editId) {
          form.reset();
          setEditorMarkdown('');
          clearDraft();
          if (privateFields) privateFields.hidden = true;
          showConnected(owner);
        } else {
          clearDraft();
        }
      } catch (error) {
        say(error instanceof Error ? error.message : '没有发布。');
      } finally {
        if (!removed) publishButton.disabled = isPrivatePost && !privatePassword;
      }
    });

    function articleName() {
      const title = (form.querySelector('[name="title"]').value || '').trim();
      if (title) return title;
      const remembered = readPrivateList().find((item) => item.id === editId);
      return remembered && remembered.title ? remembered.title : '';
    }

    function forgetPrivate(id) {
      const next = readPrivateList().filter((item) => item.id !== id);
      localStorage.setItem(privateListKey, JSON.stringify(next));
      renderPrivateList();
    }

    deleteButton?.addEventListener('click', () => {
      if (removed) return;
      const token = (tokenInput?.value || '').trim() || savedToken();
      if (!token) {
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      if (!fileSha) {
        say('还没读到这篇文章，稍后再删。');
        return;
      }
      const name = articleName();
      if (deleteCopy) {
        deleteCopy.textContent = (name ? '「' + name + '」' : '这篇文章') + '会从网站上去掉，删了找不回来。大约一分钟后生效。';
      }
      if (deleteConfirm) {
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = '确认删除';
      }
      deleteDialog?.showModal();
    });

    document.querySelector('#delete-cancel')?.addEventListener('click', () => {
      deleteDialog?.close();
    });

    deleteDialog?.addEventListener('click', (event) => {
      if (event.target === deleteDialog) deleteDialog.close();
    });

    deleteConfirm?.addEventListener('click', async () => {
      if (removed) return;
      const token = (tokenInput?.value || '').trim() || savedToken();
      if (!token || !fileSha) {
        deleteDialog?.close();
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      deleteConfirm.disabled = true;
      deleteConfirm.textContent = '正在删除…';
      if (publishButton) publishButton.disabled = true;
      try {
        localStorage.setItem(tokenKey, token);
        await identify(token);
        await removePost(token);
        removed = true;
        if (isPrivatePost || readPrivateList().some((item) => item.id === editId)) forgetPrivate(editId);
        deleteDialog?.close();
        if (deleteButton) deleteButton.hidden = true;
        say('已删除。大约一分钟后，网站上就没有这篇文章了。');
        showConnected(owner);
      } catch (error) {
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = '确认删除';
        if (publishButton) publishButton.disabled = isPrivatePost && !privatePassword;
        deleteDialog?.close();
        say(error instanceof Error ? error.message : '没有删除。');
      }
    });

    async function createPost(token, post) {
      const stamp = shanghaiStamp();
      const parts = stamp.day.split('-');
      const base = 'src/content/posts/' + parts[0] + '/' + parts[1] + '/' + parts[2] + '/' + safeName(post.title);
      const markdown = render({ ...post, iso: stamp.iso });
      for (let index = 1; index <= 5; index += 1) {
        const filePath = index === 1 ? base + '.md' : base + '-' + index + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add post: ' + post.title,
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) return filePath;
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('同名文章太多，换一个标题再试。');
    }

    async function createPrivatePost(token, post, password) {
      const stamp = shanghaiStamp();
      const envelope = await window.dorothyLock.encryptPayload(password, { ...post, date: stamp.iso });
      const markdown = renderPrivate({ ...post, iso: stamp.iso }, envelope);
      for (let attempt = 0; attempt < 3; attempt += 1) {
        const filePath = 'src/content/posts/private/' + randomId() + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add private post',
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) {
          publishedDay = stamp.day;
          return filePath;
        }
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('没有发布。');
    }

    async function updatePost(token, post, password) {
      const filePath = 'src/content/posts/' + editId + '.md';
      const iso = originalDate || shanghaiStamp().iso;
      const markdown = password
        ? renderPrivate({ ...post, iso }, await window.dorothyLock.encryptPayload(password, { ...post, date: iso }))
        : render({ ...post, iso });
      const response = await fetch(
        'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
        {
          method: 'PUT',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: password ? 'Update private post' : 'Update post: ' + post.title,
            content: utf8ToBase64(markdown),
            sha: fileSha,
            branch: 'master',
          }),
        },
      );
      if (response.ok) {
        const data = await response.json();
        fileSha = data.content && data.content.sha ? data.content.sha : fileSha;
        return filePath;
      }
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
      if (response.status === 409 || response.status === 422) throw new Error('文章刚被改过，请重新打开这一页再保存。');
      throw new Error('没有保存。');
    }

    async function removePost(token) {
      const filePath = 'src/content/posts/' + editId + '.md';
      const title = (form.querySelector('[name="title"]').value || '').trim();
      const response = await fetch(
        'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
        {
          method: 'DELETE',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: isPrivatePost ? 'Delete private post' : 'Delete post: ' + (title || editId),
            sha: fileSha,
            branch: 'master',
          }),
        },
      );
      if (response.ok) return;
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
      if (response.status === 409 || response.status === 422) throw new Error('文章刚被改过，请重新打开这一页再删除。');
      throw new Error('没有删除。');
    }

    function parseFrontmatter(markdown) {
      if (!markdown.startsWith('---\n')) throw new Error('这篇文件缺少开头信息。');
      const end = markdown.indexOf('\n---\n', 4);
      if (end === -1) throw new Error('这篇文件缺少开头信息。');
      const data = {};
      markdown.slice(4, end).split('\n').forEach((line) => {
        const index = line.indexOf(':');
        if (index === -1) return;
        const key = line.slice(0, index).trim();
        let value = line.slice(index + 1).trim();
        if (value.startsWith('"') && value.endsWith('"')) {
          value = value.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, '\\');
        }
        data[key] = value;
      });
      return { data, body: markdown.slice(end + 5) };
    }

    function base64ToUtf8(value) {
      const binary = atob(value.replace(/\n/g, ''));
      const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }

    function renderPrivate(post, envelope) {
      const lines = ['---', 'title: ' + yamlString(post.title), 'date: ' + post.iso, 'channel: ' + post.channel];
      if (post.series) lines.push('series: ' + yamlString(post.series));
      if (post.summary) lines.push('summary: ' + yamlString(post.summary));
      lines.push('private: true', '---', '', envelope, '');
      return lines.join('\n');
    }

    function randomId() {
      const bytes = crypto.getRandomValues(new Uint8Array(8));
      return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    }

    function readPrivateList() {
      try {
        const parsed = JSON.parse(localStorage.getItem(privateListKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        return [];
      }
    }

    function rememberPrivate(entry) {
      const next = [entry, ...readPrivateList().filter((item) => item.id !== entry.id)].slice(0, 40);
      localStorage.setItem(privateListKey, JSON.stringify(next));
      renderPrivateList();
    }

    function renderPrivateList() {
      const section = document.querySelector('#private-list');
      const items = document.querySelector('#private-items');
      if (!section || !items) return;
      const list = readPrivateList();
      items.replaceChildren();
      if (!list.length) {
        section.hidden = true;
        return;
      }
      section.hidden = false;
      const ul = document.createElement('ul');
      list.forEach((entry) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = '/' + entry.id + '/';
        link.textContent = (entry.title || '加密文章') + (entry.date ? ' · ' + String(entry.date).slice(0, 10) : '');
        const edit = document.createElement('a');
        edit.href = '/write/?post=' + encodeURIComponent(entry.id);
        edit.textContent = '修改';
        li.append(link, edit);
        ul.append(li);
      });
      items.append(ul);
    }

    async function refreshPrivateList() {
      if (!window.dorothyAuthor || !window.dorothyAuthor.isAuthor()) {
        renderPrivateList();
        return;
      }
      const label = document.querySelector('#private-list-label');
      if (label && !readPrivateList().length) {
        const section = document.querySelector('#private-list');
        if (section) section.hidden = false;
        label.textContent = '正在读取加密文章…';
      }
      try {
        await window.dorothyAuthor.list();
        if (label) label.textContent = '加密文章';
      } catch (error) {
        if (label) label.textContent = '这台手机上的加密文章';
      }
      renderPrivateList();
    }

    renderPrivateList();
    if (window.dorothyAuthor) refreshPrivateList();
    else document.addEventListener('dorothy-author-ready', () => { refreshPrivateList(); });

    function render(post) {
      const lines = ['---', 'title: ' + yamlString(post.title), 'date: ' + post.iso, 'channel: ' + post.channel];
      if (post.series) lines.push('series: ' + yamlString(post.series));
      if (post.summary) lines.push('summary: ' + yamlString(post.summary));
      lines.push('---', '', post.content, '');
      return lines.join('\n');
    }

    function yamlString(value) {
      return '"' + value.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ') + '"';
    }

    function safeName(value) {
      const name = value.replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, ' ').trim().replace(/^\.+/g, '').slice(0, 80).trim();
      if (!name) throw new Error('标题不能作为文件名。');
      return name;
    }

    function bytesToBase64(bytes) {
      let binary = '';
      for (let index = 0; index < bytes.length; index += 1) binary += String.fromCharCode(bytes[index]);
      return btoa(binary);
    }

    function prepareImage(file) {
      const types = { 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif', 'image/jpeg': 'jpg' };
      if (!file.type.startsWith('image/')) return Promise.reject(new Error('请选择一张图片。'));
      if (file.type === 'image/gif' || (types[file.type] && file.size < 350000)) {
        return file.arrayBuffer().then((buffer) => ({ bytes: new Uint8Array(buffer), ext: types[file.type] || 'jpg' }));
      }
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
          const scale = Math.min(1, 1600 / Math.max(image.width, image.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round(image.width * scale));
          canvas.height = Math.max(1, Math.round(image.height * scale));
          canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height);
          canvas.toBlob(async (blob) => {
            URL.revokeObjectURL(url);
            if (!blob) {
              reject(new Error('这张图片没有处理好。'));
              return;
            }
            resolve({ bytes: new Uint8Array(await blob.arrayBuffer()), ext: 'jpg' });
          }, 'image/jpeg', 0.82);
        };
        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error('这张图片打不开。换一张，或先在相册里存成 JPEG。'));
        };
        image.src = url;
      });
    }

    async function uploadImage(file) {
      const token = (tokenInput?.value || '').trim() || savedToken();
      if (!token) throw new Error('先连接 GitHub，才能把图片放进网站。');
      const prepared = await prepareImage(file);
      const stamp = shanghaiStamp();
      const [year, month, day] = stamp.day.split('-');
      let lastError = null;
      for (let attempt = 0; attempt < 2; attempt += 1) {
        const id = randomId().slice(0, 4);
        const filePath = 'public/images/' + year + '/image' + month + day + '-' + id + '.' + prepared.ext;
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add image',
              content: bytesToBase64(prepared.bytes),
              branch: 'master',
            }),
          },
        );
        if (response.ok) return '/images/' + year + '/image' + month + day + '-' + id + '.' + prepared.ext;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        lastError = response.status === 422 ? null : new Error('图片没有上传成功。');
        if (response.status !== 422) break;
      }
      throw lastError || new Error('图片没有上传成功。');
    }

    function utf8ToBase64(value) {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return btoa(binary);
    }

    function shanghaiStamp(date) {
      const text = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Shanghai',
        hourCycle: 'h23',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      }).format(date || new Date());
      const parts = text.split(' ');
      return { day: parts[0], iso: parts[0] + 'T' + parts[1] };
    }

    const draftPrefix = 'dorothyjay-draft-';
    let mdEditor = null;
    let contentField = null;
    let mdPreview = null;
    let editorMode = 'write';
    let draftTimer = null;
    let postLoaded = false;
    let suppressDraft = false;
    let pendingDraft = null;
    let editingLink = null;
    let popMode = 'link';

    function draftKey() {
      return draftPrefix + (editId || 'new');
    }

    function readDraft() {
      try {
        const data = JSON.parse(localStorage.getItem(draftKey()) || 'null');
        if (!data || typeof data !== 'object') return null;
        return data;
      } catch (error) {
        return null;
      }
    }

    function writeDraft() {
      if (suppressDraft || !contentField) return;
      const payload = {
        title: (form.querySelector('[name="title"]')?.value || '').trim(),
        channel: form.querySelector('[name="channel"]')?.value || '',
        series: (form.querySelector('[name="series"]')?.value || '').trim(),
        summary: (form.querySelector('[name="summary"]')?.value || '').trim(),
        content: contentField.value || '',
        savedAt: Date.now(),
      };
      if (!payload.title && !payload.content.trim()) {
        localStorage.removeItem(draftKey());
        hideDraftHint();
        return;
      }
      localStorage.setItem(draftKey(), JSON.stringify(payload));
      showDraftHint(payload.savedAt);
    }

    function clearDraft() {
      localStorage.removeItem(draftKey());
      hideDraftHint();
    }

    function showDraftHint(savedAt) {
      const hint = document.querySelector('#md-draft-hint');
      if (!hint) return;
      const time = new Date(savedAt).toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
      hint.textContent = '草稿已保存 ' + time;
      hint.hidden = false;
    }

    function hideDraftHint() {
      const hint = document.querySelector('#md-draft-hint');
      if (hint) hint.hidden = true;
    }

    function scheduleDraftSave() {
      if (suppressDraft) return;
      if (draftTimer) window.clearTimeout(draftTimer);
      draftTimer = window.setTimeout(writeDraft, 1200);
    }

    function applyDraft(data) {
      if (!data) return;
      suppressDraft = true;
      if (data.title) form.querySelector('[name="title"]').value = data.title;
      if (data.channel) form.querySelector('[name="channel"]').value = data.channel;
      if (data.series) form.querySelector('[name="series"]').value = data.series;
      if (data.summary) form.querySelector('[name="summary"]').value = data.summary;
      setEditorMarkdown(data.content || '');
      suppressDraft = false;
      if (data.savedAt) showDraftHint(data.savedAt);
    }

    function draftDismissed() {
      return sessionStorage.getItem('dorothyjay-draft-dismissed-' + draftKey()) === '1';
    }

    function hideDraftBanner() {
      const banner = document.querySelector('#md-draft-banner');
      if (banner) banner.hidden = true;
      pendingDraft = null;
    }

    function showDraftBanner(draft, mode) {
      if (draftDismissed()) return;
      pendingDraft = draft;
      const banner = document.querySelector('#md-draft-banner');
      const text = document.querySelector('#md-draft-banner-text');
      if (!banner || !text) return;
      const time = draft.savedAt
        ? new Date(draft.savedAt).toLocaleString('zh-CN', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' })
        : '';
      text.textContent =
        mode === 'overwrite'
          ? '这台手机上有未发布的草稿' + (time ? '（' + time + '）' : '') + '，与当前正文不同。'
          : '发现未发布的本地草稿' + (time ? '（' + time + '）' : '') + '。';
      banner.hidden = false;
    }

    function maybeRestoreDraft() {
      const draft = readDraft();
      if (!draft || !draft.content?.trim() || draftDismissed()) return;
      const hasBody = Boolean((contentField?.value || '').trim());
      const hasTitle = Boolean((form.querySelector('[name="title"]')?.value || '').trim());
      if (!editId) {
        if (!hasBody && !hasTitle) showDraftBanner(draft, 'new');
        return;
      }
      if (!postLoaded || !hasBody) return;
      if (draft.content.trim() === contentField.value.trim()) return;
      showDraftBanner(draft, 'overwrite');
    }

    function setEditorMarkdown(markdown) {
      const value = markdown || '';
      if (contentField) contentField.value = value;
      renderPreview();
      updateEditorCount();
    }

    function normalizeHeadingsForRender(source) {
      if (window.dorothyMarkdownHeadings?.normalizeLooseAtxHeadings) {
        return window.dorothyMarkdownHeadings.normalizeLooseAtxHeadings(source);
      }
      return source;
    }

    function renderPreview() {
      if (!mdPreview || !mdEditor || !contentField) return;
      const raw = contentField.value.trim();
      mdPreview.innerHTML = raw
        ? mdEditor.render(normalizeHeadingsForRender(raw))
        : '<p class="md-preview-empty">还没有内容。</p>';
    }

    function updateEditorCount() {
      const count = document.querySelector('#md-count');
      if (!count || !contentField) return;
      count.textContent = String(contentField.value.replace(/\s/g, '').length);
    }

    function escapeMdAlt(value) {
      return value.replace(/[\[\]]/g, '');
    }

    function insertTextAtCursor(text) {
      if (!contentField) return;
      const start = contentField.selectionStart;
      const end = contentField.selectionEnd;
      const normalized = text.replace(/\r\n/g, '\n');
      contentField.value = contentField.value.slice(0, start) + normalized + contentField.value.slice(end);
      const caret = start + normalized.length;
      contentField.focus();
      contentField.setSelectionRange(caret, caret);
      markEditor();
    }

    function htmlToPlainText(html) {
      if (!html) return '';
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const pieces = [];
      function walk(node) {
        if (node.nodeType === Node.TEXT_NODE) {
          pieces.push(node.textContent);
          return;
        }
        if (node.nodeType !== Node.ELEMENT_NODE) return;
        const name = node.nodeName;
        if (name === 'BR') {
          pieces.push('\n');
          return;
        }
        if (name === 'LI') pieces.push('- ');
        node.childNodes.forEach(walk);
        if (name === 'P' || name === 'DIV' || name === 'LI' || /^H[1-6]$/.test(name)) pieces.push('\n');
      }
      walk(doc.body);
      return pieces
        .join('')
        .replace(/\u00a0/g, ' ')
        .replace(/[ \t]+\n/g, '\n')
        .replace(/\n{3,}/g, '\n\n')
        .trim();
    }

    function linkAtCursor() {
      if (!contentField) return null;
      const value = contentField.value;
      const start = contentField.selectionStart;
      const end = contentField.selectionEnd;
      const probe = Math.max(start, end - 1);
      const re = /\[([^\]]*)\]\(([^)\s]+)\)/g;
      let match;
      while ((match = re.exec(value)) !== null) {
        const from = match.index;
        const to = match.index + match[0].length;
        if (probe >= from && start <= to) {
          return { from, to, text: match[1], url: match[2] };
        }
      }
      return null;
    }

    function replaceRange(from, to, text) {
      if (!contentField) return;
      const value = contentField.value;
      contentField.value = value.slice(0, from) + text + value.slice(to);
      const caret = from + text.length;
      contentField.focus();
      contentField.setSelectionRange(caret, caret);
      markEditor();
    }

    function insertMarkdown(snippet, selectionOffset, selectionLength) {
      if (!contentField) return;
      const start = contentField.selectionStart;
      const end = contentField.selectionEnd;
      const before = contentField.value.slice(0, start);
      const selected = contentField.value.slice(start, end);
      const after = contentField.value.slice(end);
      const text = snippet;
      contentField.value = before + text + after;
      const anchor = before.length + text.length + (selectionOffset || 0);
      const extent = anchor + (selectionLength || 0);
      contentField.focus();
      contentField.setSelectionRange(Math.max(0, anchor), Math.max(0, extent));
      markEditor();
    }

    function linePrefix(prefix) {
      if (!contentField) return;
      const start = contentField.selectionStart;
      const value = contentField.value;
      const lineStart = value.lastIndexOf('\n', start - 1) + 1;
      const lineEnd = value.indexOf('\n', start);
      const end = lineEnd === -1 ? value.length : lineEnd;
      const line = value.slice(lineStart, end).replace(/^#+\s*/, '').replace(/^>\s*/, '').replace(/^-\s*/, '');
      const next = prefix + line;
      contentField.value = value.slice(0, lineStart) + next + value.slice(end);
      const caret = lineStart + prefix.length;
      contentField.focus();
      contentField.setSelectionRange(caret, caret + line.length);
      markEditor();
    }

    function safeUrl(value) {
      const url = value.trim();
      if (/^(https?:\/\/|mailto:|\/)/.test(url)) return url;
      return '';
    }

    function updateToolbarForKeyboard() {
      const bar = document.querySelector('#md-editor .md-bar');
      const editor = document.querySelector('#md-editor');
      if (!bar || !editor || !window.visualViewport) return;
      const focused = document.activeElement === contentField && editorMode === 'write';
      if (!focused) {
        bar.classList.remove('md-bar-vv');
        bar.style.removeProperty('top');
        return;
      }
      const vv = window.visualViewport;
      const er = editor.getBoundingClientRect();
      const top = vv.offsetTop - er.top;
      const maxTop = Math.max(0, er.height - bar.offsetHeight - 4);
      const clamped = Math.min(Math.max(0, top), maxTop);
      bar.classList.add('md-bar-vv');
      bar.style.top = clamped + 'px';
    }

    function bindVisualViewport() {
      if (!window.visualViewport) return;
      const sync = () => updateToolbarForKeyboard();
      window.visualViewport.addEventListener('resize', sync);
      window.visualViewport.addEventListener('scroll', sync);
      window.addEventListener('scroll', sync, { passive: true });
      contentField?.addEventListener('focus', sync);
      contentField?.addEventListener('blur', () => {
        const bar = document.querySelector('#md-editor .md-bar');
        bar?.classList.remove('md-bar-vv');
        bar?.style.removeProperty('top');
      });
    }

    function setEditorMode(mode) {
      editorMode = mode;
      const writeButton = document.querySelector('#md-mode-write');
      const previewButton = document.querySelector('#md-mode-preview');
      const tools = document.querySelector('#md-tools');
      if (writeButton) {
        writeButton.classList.toggle('is-active', mode === 'write');
        writeButton.setAttribute('aria-pressed', mode === 'write' ? 'true' : 'false');
      }
      if (previewButton) {
        previewButton.classList.toggle('is-active', mode === 'preview');
        previewButton.setAttribute('aria-pressed', mode === 'preview' ? 'true' : 'false');
      }
      if (contentField) contentField.hidden = mode !== 'write';
      if (mdPreview) mdPreview.hidden = mode !== 'preview';
      if (tools) tools.hidden = mode !== 'write';
      if (mode === 'preview') {
        renderPreview();
        mdPreview?.focus();
      } else {
        contentField?.focus();
      }
      updateToolbarForKeyboard();
    }

    function openLinkPop() {
      const pop = document.querySelector('#md-pop');
      const popInput = document.querySelector('#md-pop-input');
      const popLabel = document.querySelector('#md-pop-label');
      const popOk = document.querySelector('#md-pop-ok');
      const popUnlink = document.querySelector('#md-pop-unlink');
      if (!pop || !popInput) return;
      const existing = linkAtCursor();
      editingLink = existing;
      popMode = 'link';
      if (existing) {
        if (popLabel) popLabel.textContent = '修改链接（' + existing.text + '）';
        popInput.value = existing.url;
        if (popOk) popOk.textContent = '保存';
        if (popUnlink) popUnlink.hidden = false;
      } else {
        if (popLabel) popLabel.textContent = '链接地址';
        popInput.value = '';
        if (popOk) popOk.textContent = '插入';
        if (popUnlink) popUnlink.hidden = true;
      }
      popInput.placeholder = 'https://';
      pop.hidden = false;
      popInput.focus();
    }

    function markEditor() {
      updateEditorCount();
      if (editorMode === 'preview') renderPreview();
      scheduleDraftSave();
    }

    function initEditor() {
      contentField = document.querySelector('#md-content');
      mdPreview = document.querySelector('#md-preview');
      const editor = document.querySelector('#md-editor');
      if (!editor || !contentField || !window.markdownit) return;

      mdEditor = window.markdownit({ html: true, linkify: true });
      mdEditor.validateLink = (url) => /^(https?:|mailto:|\/|#)/.test(url);

      const pop = document.querySelector('#md-pop');
      const popInput = document.querySelector('#md-pop-input');
      const popLabel = document.querySelector('#md-pop-label');
      const fileInput = document.querySelector('#md-file');
      let uploading = false;

      document.querySelector('#md-mode-write')?.addEventListener('click', () => setEditorMode('write'));
      document.querySelector('#md-mode-preview')?.addEventListener('click', () => setEditorMode('preview'));

      document.querySelector('#md-tools')?.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-md]');
        if (!button) return;
        event.preventDefault();
        const action = button.dataset.md;
        const start = contentField.selectionStart;
        const end = contentField.selectionEnd;
        const selected = contentField.value.slice(start, end);
        if (action === 'h2') linePrefix('## ');
        else if (action === 'h3') linePrefix('### ');
        else if (action === 'bold') {
          insertMarkdown('**' + (selected || '文字') + '**', selected ? 0 : -2, selected ? 0 : 2);
        } else if (action === 'italic') {
          insertMarkdown('*' + (selected || '文字') + '*', selected ? 0 : -1, selected ? 0 : 1);
        } else if (action === 'ul') linePrefix('- ');
        else if (action === 'quote') linePrefix('> ');
        else if (action === 'code') {
          if (selected && !selected.includes('\n')) {
            insertMarkdown('`' + selected + '`', 0, 0);
          } else {
            insertMarkdown('\n```\n' + (selected || '') + '\n```\n', selected ? 0 : -5, selected ? 0 : 0);
          }
        } else if (action === 'link') {
          openLinkPop();
        }
      });

      document.querySelector('#md-upload')?.addEventListener('click', () => {
        const token = (tokenInput?.value || '').trim() || savedToken();
        if (!token) {
          say('先连接 GitHub，才能把图片放进网站。');
          return;
        }
        fileInput?.click();
      });

      document.querySelector('#md-image-url')?.addEventListener('click', () => {
        popMode = 'image';
        if (popLabel) popLabel.textContent = '图片地址';
        popInput.placeholder = 'https:// 或 /images/...';
        pop.hidden = false;
        popInput.value = '';
        popInput.focus();
      });

      document.querySelector('#md-pop-cancel')?.addEventListener('click', () => {
        pop.hidden = true;
        editingLink = null;
        const popOk = document.querySelector('#md-pop-ok');
        if (popOk) popOk.textContent = '插入';
        const popUnlink = document.querySelector('#md-pop-unlink');
        if (popUnlink) popUnlink.hidden = true;
      });

      document.querySelector('#md-pop-unlink')?.addEventListener('click', () => {
        if (!editingLink) return;
        replaceRange(editingLink.from, editingLink.to, editingLink.text);
        pop.hidden = true;
        editingLink = null;
        document.querySelector('#md-pop-ok').textContent = '插入';
        document.querySelector('#md-pop-unlink').hidden = true;
      });

      document.querySelector('#md-draft-restore')?.addEventListener('click', () => {
        if (!pendingDraft) return;
        applyDraft(pendingDraft);
        hideDraftBanner();
        say('已恢复本地草稿。');
      });

      document.querySelector('#md-draft-dismiss')?.addEventListener('click', () => {
        sessionStorage.setItem('dorothyjay-draft-dismissed-' + draftKey(), '1');
        hideDraftBanner();
      });

      function insertImageMarkdown(path) {
        const alt = escapeMdAlt((form.querySelector('[name="title"]')?.value || '').trim() || '配图');
        insertMarkdown('\n\n![' + alt + '](' + path + ')\n\n', 0, 0);
      }

      fileInput?.addEventListener('change', async () => {
        const file = fileInput.files && fileInput.files[0];
        fileInput.value = '';
        if (!file || uploading) return;
        uploading = true;
        say('正在上传图片…');
        try {
          const path = await uploadImage(file);
          insertImageMarkdown(path);
          say(privateToggle?.checked ? '已插入。图片本身是公开的，大约一分钟后网站上能看到。' : '已插入。大约一分钟后网站上能看到。');
        } catch (error) {
          say(error instanceof Error ? error.message : '图片没有上传成功。');
        } finally {
          uploading = false;
        }
      });

      document.querySelector('#md-pop-ok')?.addEventListener('click', () => {
        const url = safeUrl(popInput.value);
        if (!url) {
          say('请填一个以 http 或 / 开头的地址。');
          return;
        }
        if (popMode === 'image') insertImageMarkdown(url);
        else if (editingLink) {
          replaceRange(editingLink.from, editingLink.to, '[' + editingLink.text + '](' + url + ')');
          editingLink = null;
          document.querySelector('#md-pop-ok').textContent = '插入';
          document.querySelector('#md-pop-unlink').hidden = true;
        } else {
          const start = contentField.selectionStart;
          const end = contentField.selectionEnd;
          const selected = contentField.value.slice(start, end) || url;
          insertMarkdown('[' + selected + '](' + url + ')', 0, 0);
        }
        pop.hidden = true;
      });

      popInput?.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          document.querySelector('#md-pop-ok')?.click();
        }
        if (event.key === 'Escape') pop.hidden = true;
      });

      contentField.addEventListener('input', markEditor);
      contentField.addEventListener('paste', (event) => {
        if (event.shiftKey) return;
        const data = event.clipboardData;
        if (!data) return;
        const plain = data.getData('text/plain');
        const html = data.getData('text/html');
        const text = (plain && plain.trim() ? plain : htmlToPlainText(html)).replace(/\r\n/g, '\n');
        if (!text) return;
        event.preventDefault();
        insertTextAtCursor(text);
      });
      form.querySelector('[name="title"]')?.addEventListener('input', scheduleDraftSave);
      form.querySelector('[name="summary"]')?.addEventListener('input', scheduleDraftSave);
      form.querySelector('[name="series"]')?.addEventListener('input', scheduleDraftSave);
      form.querySelector('[name="channel"]')?.addEventListener('change', scheduleDraftSave);

      bindVisualViewport();
      updateEditorCount();
      if (!editId) {
        postLoaded = true;
        maybeRestoreDraft();
      }
    }

    initEditor();
  </script>
</Base>


