---
import { channels } from '../../data/channels';
import Base from '../../layouts/Base.astro';
---

<Base title="新文章" description="在手机上写一篇文章并发布。" noindex>
  <h1 class="page-title">新文章</h1>
  <p class="lede">写完点发布。大约一分钟后，文章会出现在网站上。</p>

  <section class="token" id="token-panel">
    <p id="token-state">还没有连接这台手机。</p>
    <p class="token-help" id="token-help">
      打开
      <a href="https://github.com/settings/tokens/new?scopes=public_repo&description=DorothyJane">GitHub 新建令牌</a>
      ，勾选 <code>public_repo</code>，生成后粘贴到下面。令牌只留在这台手机里。
    </p>
    <label>
      GitHub 令牌
      <input id="token" type="password" autocomplete="off" spellcheck="false" />
    </label>
    <button class="text-button" type="button" id="save-token">保存在这台手机</button>
    <button class="text-button" type="button" id="forget-token" hidden>断开</button>
  </section>

  <section class="private-list" id="private-list" hidden>
    <p id="private-list-label">这台手机上的加密文章</p>
    <div id="private-items"></div>
  </section>

  <form class="composer" id="composer" novalidate onsubmit="return false">
    <label>
      标题
      <input name="title" required maxlength="80" />
    </label>
    <label>
      大类
      <select name="channel">
        {channels.map((channel) => <option value={channel.id}>{channel.title}</option>)}
      </select>
    </label>
    <label>
      系列
      <input name="series" placeholder="只有前端学习需要，例如 React" />
    </label>
    <label>
      摘要
      <input name="summary" placeholder="一句话，可以留空" />
    </label>
    <div class="editor-field">
      <p class="field-name">正文</p>
      <div class="md-editor" id="md-editor">
        <div class="md-bar" role="toolbar" aria-label="正文格式">
          <button type="button" data-cmd="undo" aria-label="撤销"><svg viewBox="0 0 24 24"><path d="M9 14L5 10l4-4" /><path d="M5 10h8a5 5 0 1 1 0 8h-2" /></svg></button>
          <button type="button" data-cmd="redo" aria-label="重做"><svg viewBox="0 0 24 24"><path d="M15 14l4-4-4-4" /><path d="M19 10h-8a5 5 0 1 0 0 8h2" /></svg></button>
          <span class="md-gap"></span>
          <select id="md-style" aria-label="段落样式">
            <option value="P">常规</option>
            <option value="H2">标题</option>
            <option value="H3">小标题</option>
            <option value="H4">小节</option>
          </select>
          <span class="md-gap"></span>
          <button type="button" data-cmd="bold" aria-label="加粗"><b>B</b></button>
          <button type="button" data-cmd="italic" aria-label="斜体"><i>I</i></button>
          <button type="button" data-cmd="underline" aria-label="下划线"><u>U</u></button>
          <button type="button" data-cmd="strikeThrough" aria-label="删除线"><s>S</s></button>
          <span class="md-gap"></span>
          <button type="button" data-cmd="insertUnorderedList" aria-label="无序列表"><svg viewBox="0 0 24 24"><path d="M10 7h10M10 12h10M10 17h10" /><circle cx="5.5" cy="7" r="1.6" /><circle cx="5.5" cy="12" r="1.6" /><circle cx="5.5" cy="17" r="1.6" /></svg></button>
          <button type="button" data-cmd="insertOrderedList" aria-label="有序列表"><svg viewBox="0 0 24 24"><path d="M10 7h10M10 12h10M10 17h10" /><path d="M4 8V5l-1 .5M3.5 12h2M3.5 10.5c.8 0 1.5.4 1.5 1.2S4.2 13 3.2 13M4 16c.8.4 1.2.9 1.2 1.5 0 .8-.7 1.5-1.7 1.5H3" /></svg></button>
          <span class="md-gap"></span>
          <button type="button" data-cmd="link" aria-label="链接"><svg viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.2 1.2" /><path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.2-1.2" /></svg></button>
          <button type="button" data-cmd="image" aria-label="图片"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="14" rx="1.5" /><circle cx="9" cy="10" r="1.3" /><path d="M4 16l4.5-4 3.5 3 2.5-2L20 16" /></svg></button>
          <button type="button" data-cmd="quote" aria-label="引用"><svg viewBox="0 0 24 24"><path d="M8 16c-2 0-3-1.4-3-3.2V9h4v4H7.2c.2 1.4.8 2 1.8 2.2" /><path d="M16 16c-2 0-3-1.4-3-3.2V9h4v4h-1.8c.2 1.4.8 2 1.8 2.2" /></svg></button>
          <button type="button" data-cmd="hr" aria-label="分隔线"><svg viewBox="0 0 24 24"><path d="M5 12h14" /></svg></button>
          <button type="button" data-cmd="code" aria-label="代码"><svg viewBox="0 0 24 24"><path d="M9 8l-4 4 4 4M15 8l4 4-4 4" /></svg></button>
        </div>
        <div class="md-pop" id="md-pop" hidden>
          <input id="md-pop-input" type="text" inputmode="url" autocomplete="off" placeholder="https://" />
          <button type="button" id="md-pop-ok">插入</button>
        </div>
        <div id="md-surface" class="md-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-label="正文" data-placeholder="开始写"></div>
        <div class="md-foot"><span id="md-count">0</span></div>
      </div>
      <textarea class="md-source" name="content" hidden></textarea>
    </div>
    <div id="private-block">
      <label class="check">
        <input id="private-toggle" type="checkbox" />
        加密正文
      </label>
      <div id="private-fields" hidden>
        <p>标题和分类会出现在文章列表里，并标成加密。正文要密码才能看，网站不保存密码。改已经发出去的文章时，网址和分类不变。</p>
        <label>
          密码
          <input id="private-password" type="password" autocomplete="new-password" />
        </label>
        <label id="private-confirm-label">
          再输入一次
          <input id="private-password2" type="password" autocomplete="new-password" />
        </label>
        <button class="text-button" type="button" id="open-private" hidden>打开原文</button>
      </div>
    </div>
    <p class="composer-status" id="composer-status" role="status"></p>
    <div class="composer-actions">
      <button class="publish" type="button" id="publish">发布</button>
      <button class="text-button" type="button" id="delete-post" hidden>删除</button>
    </div>
  </form>
  <dialog class="delete-dialog" id="delete-dialog">
    <h2>删除这篇文章？</h2>
    <p id="delete-copy"></p>
    <div class="dialog-actions">
      <button type="button" id="delete-cancel">取消</button>
      <button class="danger" type="button" id="delete-confirm">确认删除</button>
    </div>
  </dialog>
  <script is:inline src="/vendor/markdown-it.js"></script>
  <script is:inline src="/vendor/turndown.js"></script>
  <script is:inline src="/vendor/turndown-plugin-gfm.js"></script>
  <script is:inline src="/lock.js"></script>
  <script is:inline>
    const repo = 'DENGCPU/DENGCPU.github.io';
    const owner = 'DENGCPU';
    const tokenKey = 'dorothyjay-github-token';
    const tokenInput = document.querySelector('#token');
    const tokenState = document.querySelector('#token-state');
    const tokenHelp = document.querySelector('#token-help');
    const saveButton = document.querySelector('#save-token');
    const forgetButton = document.querySelector('#forget-token');
    const form = document.querySelector('#composer');
    const status = document.querySelector('#composer-status');
    const publishButton = document.querySelector('#publish');
    const deleteButton = document.querySelector('#delete-post');
    const deleteDialog = document.querySelector('#delete-dialog');
    const deleteCopy = document.querySelector('#delete-copy');
    const deleteConfirm = document.querySelector('#delete-confirm');

    const headers = (token) => {
      const result = {
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
      };
      if (token) result.Authorization = 'Bearer ' + token;
      return result;
    };

    function say(message) {
      if (!status) return;
      status.textContent = message;
      status.scrollIntoView({ block: 'nearest' });
    }

    function savedToken() {
      return (localStorage.getItem(tokenKey) || '').trim();
    }

    function showConnected(login) {
      if (tokenState) tokenState.textContent = '已连接 ' + login + '。下次打开可以直接写。';
      if (tokenHelp) tokenHelp.hidden = true;
      if (saveButton) saveButton.hidden = true;
      if (forgetButton) forgetButton.hidden = false;
      if (tokenInput) {
        tokenInput.value = '';
        const label = tokenInput.closest('label');
        if (label) label.hidden = true;
      }
    }

    function showDisconnected() {
      if (tokenState) tokenState.textContent = '还没有连接这台手机。';
      if (tokenHelp) tokenHelp.hidden = false;
      if (saveButton) saveButton.hidden = false;
      if (forgetButton) forgetButton.hidden = true;
      if (tokenInput) {
        const label = tokenInput.closest('label');
        if (label) label.hidden = false;
      }
    }

    async function github(token, path, init) {
      const response = await fetch('https://api.github.com' + path, {
        ...(init || {}),
        headers: { ...headers(token), ...((init && init.headers) || {}) },
      });
      const text = await response.text();
      const data = text ? JSON.parse(text) : {};
      return { response, data };
    }

    async function identify(token) {
      const { response, data } = await github(token, '/user');
      if (!response.ok) throw new Error('这个令牌无效，或已经过期。');
      if (data.login !== owner) throw new Error('这个令牌不是站点主人的。');
      return data.login;
    }

    saveButton?.addEventListener('click', async () => {
      const token = (tokenInput?.value || '').trim();
      if (!token) {
        say('先粘贴令牌。');
        return;
      }
      say('正在连接…');
      try {
        const login = await identify(token);
        localStorage.setItem(tokenKey, token);
        window.dorothyAuthor?.markAuthor();
        showConnected(login);
        refreshPrivateList();
        if (editId && !fileSha) await loadPost();
        else if (!editId) say('已保存在这台手机。');
      } catch (error) {
        say(error instanceof Error ? error.message : '没有连上。');
      }
    });

    forgetButton?.addEventListener('click', () => {
      localStorage.removeItem(tokenKey);
      showDisconnected();
      say('已从这台手机断开。');
    });

    const privateListKey = 'dorothyjay-private-posts';
    const datedPost = /^[0-9]{4}\/[0-9]{2}\/[0-9]{2}\/[^/]+$/;
    const lockedPost = /^private\/[a-f0-9]{16}$/;
    const editId = new URLSearchParams(location.search).get('post') || '';
    const privateToggle = document.querySelector('#private-toggle');
    const privateFields = document.querySelector('#private-fields');
    let fileSha = '';
    let originalDate = '';
    let isPrivatePost = false;
    let removed = false;
    let cipherText = '';
    let privatePassword = '';
    let publishedDay = '';

    function editable(id) {
      return datedPost.test(id) || lockedPost.test(id);
    }

    if (editId && !editable(editId)) {
      say('这篇文章的地址不对。');
    } else if (editId) {
      const heading = document.querySelector('h1');
      const lede = document.querySelector('.lede');
      if (heading) heading.textContent = '修改文章';
      if (lede) lede.textContent = '改完点保存。大约一分钟后，网站上会换成新的内容。网址不变。';
      if (publishButton) publishButton.textContent = '保存';
      if (deleteButton) deleteButton.hidden = false;
      document.title = '修改文章 · DorothyJane';
    }

    privateToggle?.addEventListener('change', () => {
      if (isPrivatePost) {
        privateToggle.checked = true;
        return;
      }
      if (privateFields) privateFields.hidden = !privateToggle.checked;
    });

    document.querySelector('#open-private')?.addEventListener('click', async () => {
      const password = document.querySelector('#private-password')?.value || '';
      if (!password) {
        say('先输入密码。');
        return;
      }
      if (!window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      say('正在打开…');
      try {
        const payload = await window.dorothyLock.decryptPayload(password, cipherText);
        window.dorothyAuthor?.markAuthor();
        privatePassword = password;
        rememberPrivate({
          id: editId,
          title: payload.title || '',
          date: String(payload.date || originalDate || '').slice(0, 10),
          channel: payload.channel || '',
          series: payload.series || '',
        });
        form.querySelector('[name="title"]').value = payload.title || '';
        if (payload.channel) form.querySelector('[name="channel"]').value = payload.channel;
        form.querySelector('[name="series"]').value = payload.series || '';
        form.querySelector('[name="summary"]').value = payload.summary || '';
        setEditorMarkdown(payload.content || '');
        if (publishButton) publishButton.disabled = false;
        if (privateFields) privateFields.hidden = true;
        say('已打开。改完点保存，仍用这个密码。');
      } catch (error) {
        say(error instanceof Error ? error.message : '密码不对。');
      }
    });

    async function loadPost() {
      if (!editId) return;
      say('正在读取原文…');
      const filePath = 'src/content/posts/' + editId + '.md';
      const apiPath = '/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/');
      let result = await github('', apiPath);
      if (!result.response.ok && savedToken()) result = await github(savedToken(), apiPath);
      if (!result.response.ok) throw new Error('没有读到这篇文章。');
      const data = result.data;
      fileSha = data.sha;
      const markdown = data.content ? base64ToUtf8(data.content) : await (await fetch(data.download_url)).text();
      const parsed = parseFrontmatter(markdown);
      originalDate = parsed.data.date || '';
      if (parsed.data.private === 'true') {
        isPrivatePost = true;
        cipherText = parsed.body.trim();
        if (privateToggle) {
          privateToggle.checked = true;
          privateToggle.disabled = true;
        }
        if (privateFields) privateFields.hidden = false;
        const confirmLabel = document.querySelector('#private-confirm-label');
        const openButton = document.querySelector('#open-private');
        if (confirmLabel) confirmLabel.hidden = true;
        if (openButton) openButton.hidden = false;
        if (publishButton) publishButton.disabled = true;
        const knownTitle = parsed.data.title && parsed.data.title !== 'private';
        if (knownTitle) {
          form.querySelector('[name="title"]').value = parsed.data.title;
          if (parsed.data.channel) form.querySelector('[name="channel"]').value = parsed.data.channel;
          form.querySelector('[name="series"]').value = parsed.data.series || '';
          form.querySelector('[name="summary"]').value = parsed.data.summary || '';
        }
        say(knownTitle ? '标题已经在。输入密码后才能改正文。' : '输入密码，打开原文后再改。');
        return;
      }
      form.querySelector('[name="title"]').value = parsed.data.title || '';
      if (parsed.data.channel) form.querySelector('[name="channel"]').value = parsed.data.channel;
      form.querySelector('[name="series"]').value = parsed.data.series || '';
      form.querySelector('[name="summary"]').value = parsed.data.summary || '';
      setEditorMarkdown(parsed.body.replace(/^\n/, '').replace(/\n$/, ''));
      say('');
    }

    if (editId && editable(editId)) {
      loadPost().catch((error) => {
        say(error instanceof Error ? error.message : '没有读到这篇文章。');
      });
    }

    if (savedToken()) {
      identify(savedToken())
        .then(showConnected)
        .catch(() => {
          localStorage.removeItem(tokenKey);
          showDisconnected();
        });
    }

    publishButton?.addEventListener('click', async () => {
      if (editorDirty) contentField.value = currentMarkdown();
      const typed = (tokenInput?.value || '').trim();
      const token = typed || savedToken();
      if (!token) {
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      const data = new FormData(form);
      const title = String(data.get('title') || '').trim();
      const channel = String(data.get('channel') || '');
      const series = String(data.get('series') || '').trim();
      const summary = String(data.get('summary') || '').trim();
      const content = String(data.get('content') || '').trim();
      if (!title || !content) {
        say('标题和正文都要写。');
        return;
      }
      const turningPrivate = !isPrivatePost && Boolean(privateToggle?.checked);
      const wantsPrivate = isPrivatePost || turningPrivate;
      let password = privatePassword;
      if (turningPrivate) {
        const first = document.querySelector('#private-password')?.value || '';
        const second = document.querySelector('#private-password2')?.value || '';
        if (first.length < 8) {
          say('密码至少 8 位。');
          return;
        }
        if (first !== second) {
          say('两次密码不一致。');
          return;
        }
        password = first;
      }
      if (wantsPrivate && !password) {
        say('先输入密码，打开原文。');
        return;
      }
      if (wantsPrivate && !window.dorothyLock) {
        say('加密组件没有加载。');
        return;
      }
      publishButton.disabled = true;
      say(editId ? '正在保存…' : '正在发布…');
      try {
        localStorage.setItem(tokenKey, token);
        window.dorothyAuthor?.markAuthor();
        await identify(token);
        const post = { title, channel, series, summary, content };
        const filePath = editId
          ? await updatePost(token, post, wantsPrivate ? password : '')
          : wantsPrivate
            ? await createPrivatePost(token, post, password)
            : await createPost(token, post);
        const id = filePath.replace(/^src\/content\/posts\//, '').replace(/\.md$/, '');
        const url = 'https://dengcpu.github.io/' + id + '/';
        if (wantsPrivate) {
          rememberPrivate({ id, title, date: publishedDay || originalDate.slice(0, 10), channel, series });
          refreshPrivateList();
        }
        if (editId && turningPrivate) {
          isPrivatePost = true;
          privatePassword = password;
          if (privateToggle) {
            privateToggle.checked = true;
            privateToggle.disabled = true;
          }
        }
        status.textContent = '';
        status.append(
          (editId ? '已保存。大约一分钟后打开：' : '已发布。大约一分钟后打开：') +
            (wantsPrivate ? (editId ? '网址和分类不变，打开需要密码。' : '它会出现在所选分类里，打开需要密码。') : ''),
          Object.assign(document.createElement('a'), { href: url, textContent: url }),
        );
        if (!editId) {
          form.reset();
          setEditorMarkdown('');
          if (privateFields) privateFields.hidden = true;
          showConnected(owner);
        }
      } catch (error) {
        say(error instanceof Error ? error.message : '没有发布。');
      } finally {
        if (!removed) publishButton.disabled = isPrivatePost && !privatePassword;
      }
    });

    function articleName() {
      const title = (form.querySelector('[name="title"]').value || '').trim();
      if (title) return title;
      const remembered = readPrivateList().find((item) => item.id === editId);
      return remembered && remembered.title ? remembered.title : '';
    }

    function forgetPrivate(id) {
      const next = readPrivateList().filter((item) => item.id !== id);
      localStorage.setItem(privateListKey, JSON.stringify(next));
      renderPrivateList();
    }

    deleteButton?.addEventListener('click', () => {
      if (removed) return;
      const token = (tokenInput?.value || '').trim() || savedToken();
      if (!token) {
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      if (!fileSha) {
        say('还没读到这篇文章，稍后再删。');
        return;
      }
      const name = articleName();
      if (deleteCopy) {
        deleteCopy.textContent = (name ? '「' + name + '」' : '这篇文章') + '会从网站上去掉，删了找不回来。大约一分钟后生效。';
      }
      if (deleteConfirm) {
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = '确认删除';
      }
      deleteDialog?.showModal();
    });

    document.querySelector('#delete-cancel')?.addEventListener('click', () => {
      deleteDialog?.close();
    });

    deleteDialog?.addEventListener('click', (event) => {
      if (event.target === deleteDialog) deleteDialog.close();
    });

    deleteConfirm?.addEventListener('click', async () => {
      if (removed) return;
      const token = (tokenInput?.value || '').trim() || savedToken();
      if (!token || !fileSha) {
        deleteDialog?.close();
        say('先把 GitHub 令牌粘贴到上面。');
        return;
      }
      deleteConfirm.disabled = true;
      deleteConfirm.textContent = '正在删除…';
      if (publishButton) publishButton.disabled = true;
      try {
        localStorage.setItem(tokenKey, token);
        await identify(token);
        await removePost(token);
        removed = true;
        if (isPrivatePost || readPrivateList().some((item) => item.id === editId)) forgetPrivate(editId);
        deleteDialog?.close();
        if (deleteButton) deleteButton.hidden = true;
        say('已删除。大约一分钟后，网站上就没有这篇文章了。');
        showConnected(owner);
      } catch (error) {
        deleteConfirm.disabled = false;
        deleteConfirm.textContent = '确认删除';
        if (publishButton) publishButton.disabled = isPrivatePost && !privatePassword;
        deleteDialog?.close();
        say(error instanceof Error ? error.message : '没有删除。');
      }
    });

    async function createPost(token, post) {
      const stamp = shanghaiStamp();
      const parts = stamp.day.split('-');
      const base = 'src/content/posts/' + parts[0] + '/' + parts[1] + '/' + parts[2] + '/' + safeName(post.title);
      const markdown = render({ ...post, iso: stamp.iso });
      for (let index = 1; index <= 5; index += 1) {
        const filePath = index === 1 ? base + '.md' : base + '-' + index + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add post: ' + post.title,
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) return filePath;
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('同名文章太多，换一个标题再试。');
    }

    async function createPrivatePost(token, post, password) {
      const stamp = shanghaiStamp();
      const envelope = await window.dorothyLock.encryptPayload(password, { ...post, date: stamp.iso });
      const markdown = renderPrivate({ ...post, iso: stamp.iso }, envelope);
      for (let attempt = 0; attempt < 3; attempt += 1) {
        const filePath = 'src/content/posts/private/' + randomId() + '.md';
        const response = await fetch(
          'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
          {
            method: 'PUT',
            headers: { ...headers(token), 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: 'Add private post',
              content: utf8ToBase64(markdown),
              branch: 'master',
            }),
          },
        );
        if (response.ok) {
          publishedDay = stamp.day;
          return filePath;
        }
        if (response.status === 422 || response.status === 409) continue;
        if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
        throw new Error('发布没有成功。');
      }
      throw new Error('没有发布。');
    }

    async function updatePost(token, post, password) {
      const filePath = 'src/content/posts/' + editId + '.md';
      const iso = originalDate || shanghaiStamp().iso;
      const markdown = password
        ? renderPrivate({ ...post, iso }, await window.dorothyLock.encryptPayload(password, { ...post, date: iso }))
        : render({ ...post, iso });
      const response = await fetch(
        'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
        {
          method: 'PUT',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: password ? 'Update private post' : 'Update post: ' + post.title,
            content: utf8ToBase64(markdown),
            sha: fileSha,
            branch: 'master',
          }),
        },
      );
      if (response.ok) {
        const data = await response.json();
        fileSha = data.content && data.content.sha ? data.content.sha : fileSha;
        return filePath;
      }
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
      if (response.status === 409 || response.status === 422) throw new Error('文章刚被改过，请重新打开这一页再保存。');
      throw new Error('没有保存。');
    }

    async function removePost(token) {
      const filePath = 'src/content/posts/' + editId + '.md';
      const title = (form.querySelector('[name="title"]').value || '').trim();
      const response = await fetch(
        'https://api.github.com/repos/' + repo + '/contents/' + filePath.split('/').map(encodeURIComponent).join('/'),
        {
          method: 'DELETE',
          headers: { ...headers(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: isPrivatePost ? 'Delete private post' : 'Delete post: ' + (title || editId),
            sha: fileSha,
            branch: 'master',
          }),
        },
      );
      if (response.ok) return;
      if (response.status === 401 || response.status === 403) throw new Error('令牌没有写入这个仓库的权限。生成时要勾选 public_repo。');
      if (response.status === 409 || response.status === 422) throw new Error('文章刚被改过，请重新打开这一页再删除。');
      throw new Error('没有删除。');
    }

    function parseFrontmatter(markdown) {
      if (!markdown.startsWith('---\n')) throw new Error('这篇文件缺少开头信息。');
      const end = markdown.indexOf('\n---\n', 4);
      if (end === -1) throw new Error('这篇文件缺少开头信息。');
      const data = {};
      markdown.slice(4, end).split('\n').forEach((line) => {
        const index = line.indexOf(':');
        if (index === -1) return;
        const key = line.slice(0, index).trim();
        let value = line.slice(index + 1).trim();
        if (value.startsWith('"') && value.endsWith('"')) {
          value = value.slice(1, -1).replace(/\\"/g, '"').replace(/\\\\/g, '\\');
        }
        data[key] = value;
      });
      return { data, body: markdown.slice(end + 5) };
    }

    function base64ToUtf8(value) {
      const binary = atob(value.replace(/\n/g, ''));
      const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    }

    function renderPrivate(post, envelope) {
      const lines = ['---', 'title: ' + yamlString(post.title), 'date: ' + post.iso, 'channel: ' + post.channel];
      if (post.series) lines.push('series: ' + yamlString(post.series));
      if (post.summary) lines.push('summary: ' + yamlString(post.summary));
      lines.push('private: true', '---', '', envelope, '');
      return lines.join('\n');
    }

    function randomId() {
      const bytes = crypto.getRandomValues(new Uint8Array(8));
      return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');
    }

    function readPrivateList() {
      try {
        const parsed = JSON.parse(localStorage.getItem(privateListKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        return [];
      }
    }

    function rememberPrivate(entry) {
      const next = [entry, ...readPrivateList().filter((item) => item.id !== entry.id)].slice(0, 40);
      localStorage.setItem(privateListKey, JSON.stringify(next));
      renderPrivateList();
    }

    function renderPrivateList() {
      const section = document.querySelector('#private-list');
      const items = document.querySelector('#private-items');
      if (!section || !items) return;
      const list = readPrivateList();
      items.replaceChildren();
      if (!list.length) {
        section.hidden = true;
        return;
      }
      section.hidden = false;
      const ul = document.createElement('ul');
      list.forEach((entry) => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = '/' + entry.id + '/';
        link.textContent = (entry.title || '加密文章') + (entry.date ? ' · ' + String(entry.date).slice(0, 10) : '');
        const edit = document.createElement('a');
        edit.href = '/write/?post=' + encodeURIComponent(entry.id);
        edit.textContent = '修改';
        li.append(link, edit);
        ul.append(li);
      });
      items.append(ul);
    }

    async function refreshPrivateList() {
      if (!window.dorothyAuthor || !window.dorothyAuthor.isAuthor()) {
        renderPrivateList();
        return;
      }
      const label = document.querySelector('#private-list-label');
      if (label && !readPrivateList().length) {
        const section = document.querySelector('#private-list');
        if (section) section.hidden = false;
        label.textContent = '正在读取加密文章…';
      }
      try {
        await window.dorothyAuthor.list();
        if (label) label.textContent = '加密文章';
      } catch (error) {
        if (label) label.textContent = '这台手机上的加密文章';
      }
      renderPrivateList();
    }

    renderPrivateList();
    if (window.dorothyAuthor) refreshPrivateList();
    else document.addEventListener('dorothy-author-ready', () => { refreshPrivateList(); });

    function render(post) {
      const lines = ['---', 'title: ' + yamlString(post.title), 'date: ' + post.iso, 'channel: ' + post.channel];
      if (post.series) lines.push('series: ' + yamlString(post.series));
      if (post.summary) lines.push('summary: ' + yamlString(post.summary));
      lines.push('---', '', post.content, '');
      return lines.join('\n');
    }

    function yamlString(value) {
      return '"' + value.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\n/g, ' ') + '"';
    }

    function safeName(value) {
      const name = value.replace(/[\\/:*?"<>|]/g, '').replace(/\s+/g, ' ').trim().replace(/^\.+/g, '').slice(0, 80).trim();
      if (!name) throw new Error('标题不能作为文件名。');
      return name;
    }

    function utf8ToBase64(value) {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return btoa(binary);
    }

    function shanghaiStamp(date) {
      const text = new Intl.DateTimeFormat('sv-SE', {
        timeZone: 'Asia/Shanghai',
        hourCycle: 'h23',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      }).format(date || new Date());
      const parts = text.split(' ');
      return { day: parts[0], iso: parts[0] + 'T' + parts[1] };
    }

    let editorDirty = false;
    let mdEditor = null;
    let mdSurface = null;
    let contentField = null;
    let turndownService = null;
    let savedRange = null;

    function setEditorMarkdown(markdown) {
      const value = markdown || '';
      editorDirty = false;
      if (contentField) contentField.value = value;
      if (!mdSurface || !mdEditor) return;
      mdSurface.innerHTML = value ? mdEditor.render(value) : '';
      updateEditorCount();
    }

    function currentMarkdown() {
      if (!mdSurface || !turndownService) return contentField ? contentField.value : '';
      const clone = mdSurface.cloneNode(true);
      clone.querySelectorAll('[style]').forEach((node) => node.removeAttribute('style'));
      return turndownService
        .turndown(clone.innerHTML)
        .replace(/\n{3,}/g, '\n\n')
        .replace(/^(\s*)([-*+]|\d+\.) {2,}/gm, '$1$2 ')
        .trim();
    }

    function updateEditorCount() {
      const count = document.querySelector('#md-count');
      if (!count || !mdSurface) return;
      count.textContent = String(mdSurface.innerText.replace(/\n$/, '').trim().length);
    }

    function saveSelection() {
      const selection = getSelection();
      if (!selection || !selection.rangeCount || !mdSurface.contains(selection.anchorNode)) return;
      savedRange = selection.getRangeAt(0);
    }

    function restoreSelection() {
      mdSurface.focus();
      if (!savedRange) return;
      const selection = getSelection();
      selection.removeAllRanges();
      selection.addRange(savedRange);
    }

    function escapeHtml(value) {
      return value.replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]);
    }

    function safeUrl(value) {
      const url = value.trim();
      if (/^(https?:\/\/|mailto:|\/)/.test(url)) return url;
      return '';
    }

    function formatBlock(tag) {
      document.execCommand('formatBlock', false, '<' + tag.toLowerCase() + '>');
    }

    function insertCode() {
      const selection = getSelection();
      const text = selection && mdSurface.contains(selection.anchorNode) ? selection.toString() : '';
      const block = text.includes('\n') || !text;
      const html = block
        ? '<pre><code>' + escapeHtml(text || '代码') + '</code></pre>'
        : '<code>' + escapeHtml(text) + '</code>';
      document.execCommand('insertHTML', false, html);
    }

    function refreshToolbar() {
      const bar = document.querySelector('.md-bar');
      if (!bar) return;
      bar.querySelectorAll('button[data-cmd]').forEach((button) => {
        const command = button.dataset.cmd;
        if (!['bold', 'italic', 'underline', 'strikeThrough', 'insertUnorderedList', 'insertOrderedList'].includes(command)) return;
        button.setAttribute('aria-pressed', document.queryCommandState(command) ? 'true' : 'false');
      });
      const styleSelect = document.querySelector('#md-style');
      const selection = getSelection();
      if (!styleSelect || !selection || !selection.anchorNode || !mdSurface.contains(selection.anchorNode)) return;
      const node = selection.anchorNode.nodeType === 1 ? selection.anchorNode : selection.anchorNode.parentElement;
      const block = node && node.closest('h2, h3, h4, p');
      const value = block ? block.tagName : 'P';
      if ([...styleSelect.options].some((option) => option.value === value)) styleSelect.value = value;
    }

    function markEditor() {
      editorDirty = true;
      if (contentField) contentField.value = currentMarkdown();
      updateEditorCount();
      refreshToolbar();
    }

    function initEditor() {
      const editor = document.querySelector('#md-editor');
      contentField = document.querySelector('[name="content"]');
      mdSurface = document.querySelector('#md-surface');
      if (!editor || !contentField || !mdSurface || !window.markdownit || !window.TurndownService || !window.turndownPluginGfm) {
        if (contentField) contentField.classList.add('is-open');
        if (editor) editor.hidden = true;
        return;
      }
      mdEditor = window.markdownit({ html: true, linkify: true });
      mdEditor.validateLink = (url) => /^(https?:|mailto:|\/|#)/.test(url);
      turndownService = new window.TurndownService({
        headingStyle: 'atx',
        codeBlockStyle: 'fenced',
        bulletListMarker: '-',
        emDelimiter: '*',
        strongDelimiter: '**',
      });
      turndownService.use(window.turndownPluginGfm.gfm);
      turndownService.addRule('div', {
        filter: 'div',
        replacement: (content) => '\n\n' + content + '\n\n',
      });
      turndownService.addRule('keepHtml', {
        filter: ['u', 's', 'strike'],
        replacement: (content, node) => {
          const tag = node.nodeName.toLowerCase() === 'strike' ? 's' : node.nodeName.toLowerCase();
          return '<' + tag + '>' + content + '</' + tag + '>';
        },
      });
      document.execCommand('defaultParagraphSeparator', false, 'p');

      const pop = document.querySelector('#md-pop');
      const popInput = document.querySelector('#md-pop-input');
      let popMode = 'link';

      editor.querySelector('.md-bar').addEventListener('mousedown', (event) => {
        if (event.target.closest('button')) {
          saveSelection();
          event.preventDefault();
        }
      });
      document.querySelector('#md-style').addEventListener('mousedown', saveSelection);
      document.querySelector('#md-style').addEventListener('change', (event) => {
        restoreSelection();
        formatBlock(event.target.value);
        markEditor();
      });
      editor.querySelector('.md-bar').addEventListener('click', (event) => {
        const button = event.target.closest('button[data-cmd]');
        if (!button) return;
        const command = button.dataset.cmd;
        restoreSelection();
        if (command === 'link' || command === 'image') {
          popMode = command;
          pop.hidden = false;
          popInput.value = '';
          popInput.placeholder = command === 'image' ? '图片地址' : '链接地址';
          popInput.focus();
          return;
        }
        if (command === 'quote') formatBlock('blockquote');
        else if (command === 'code') insertCode();
        else if (command === 'hr') document.execCommand('insertHorizontalRule');
        else document.execCommand(command);
        markEditor();
      });
      document.querySelector('#md-pop-ok').addEventListener('click', () => {
        const url = safeUrl(popInput.value);
        if (!url) {
          say('请填一个 http 开头的地址。');
          return;
        }
        restoreSelection();
        if (popMode === 'image') {
          document.execCommand('insertImage', false, url);
        } else {
          const selection = getSelection();
          if (!selection || selection.isCollapsed) {
            document.execCommand('insertHTML', false, '<a href="' + escapeHtml(url) + '">' + escapeHtml(url) + '</a>');
          } else {
            document.execCommand('createLink', false, url);
          }
        }
        pop.hidden = true;
        markEditor();
      });
      popInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          document.querySelector('#md-pop-ok').click();
        }
      });
      mdSurface.addEventListener('input', markEditor);
      mdSurface.addEventListener('keyup', refreshToolbar);
      mdSurface.addEventListener('mouseup', refreshToolbar);
      document.addEventListener('selectionchange', () => {
        if (document.activeElement === mdSurface) refreshToolbar();
      });
      updateEditorCount();
    }

    initEditor();
  </script>
</Base>


