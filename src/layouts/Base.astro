---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, wide = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '首页' },
  { href: '/writing/', label: '文章' },
  { href: '/work/', label: '作品' },
  { href: '/about/', label: '关于' },
  { href: '/write/', label: '新文章' },
];

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class={wide ? 'wide' : undefined}>
    {path === '/' && <canvas id="side-trees" class="side-trees" aria-hidden="true"></canvas>}
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/">{site.name}</a>
        <div class="nav-group">
          <nav class="site-nav" aria-label="主导航">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="切换为深色模式">
            <svg class="when-light" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M14.6 3.1a8.4 8.4 0 1 0 6.5 13.2A7.2 7.2 0 0 1 14.6 3.1z"></path>
            </svg>
            <svg class="when-dark" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.4" fill="currentColor"></circle>
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2"></path>
                <path d="M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"></path>
              </g>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <a href="/write/">新文章</a>
        <span aria-hidden="true"> · </span>
        <a href={site.about.github}>{site.name}</a>
      </div>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const syncLabel = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        button?.setAttribute('aria-label', dark ? '切换为浅色模式' : '切换为深色模式');
      };
      syncLabel();
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncLabel();
      });

      const canvas = document.getElementById('side-trees');
      if (canvas instanceof HTMLCanvasElement) {
          const spread = Math.PI / 7;
        const segments: number[][] = [];
        let generation = 0;
        let ctx: CanvasRenderingContext2D | null = null;
        let width = 0;
        let height = 0;
        let dpr = 1;

        const ink = () =>
          document.documentElement.dataset.theme === 'dark'
            ? 'rgba(244, 234, 220, 0.34)'
            : 'rgba(74, 52, 36, 0.38)';

        const paint = () => {
          if (!ctx) return;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, width, height);
          ctx.lineWidth = 1.15;
          ctx.lineCap = 'round';
          ctx.strokeStyle = ink();
          ctx.beginPath();
          for (const [x1, y1, x2, y2] of segments) {
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
          }
          ctx.stroke();
        };

        const grow = () => {
          if (matchMedia('(max-width: 760px)').matches) {
            generation += 1;
            segments.length = 0;
            canvas.width = 0;
            canvas.height = 0;
            return;
          }
          const gen = ++generation;
          segments.length = 0;
          width = window.innerWidth;
          height = window.innerHeight;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          ctx = canvas.getContext('2d');
          if (!ctx) return;

          const gutter = Math.max(96, (width - 46 * 16) / 2 - 8);
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const sprouts = [
            { x: -8, y: height * 0.86, rad: -0.62, life: 0 },
            { x: width - 28, y: -12, rad: Math.PI / 2 + 0.22, life: 0 },
          ];

          const step = (branch: { x: number; y: number; rad: number; life: number }) => {
            const length = 10 + Math.random() * 18;
            const nx = branch.x + Math.cos(branch.rad) * length;
            const ny = branch.y + Math.sin(branch.rad) * length;
            segments.push([branch.x, branch.y, nx, ny]);
            const life = branch.life + 1;
            if (life > 18) return;
            if (nx < -40 || nx > width + 40 || ny < -40 || ny > height + 40) return;
            const fromLeft = branch.x < width / 2;
            if (fromLeft && nx > gutter) return;
            if (!fromLeft && nx < width - gutter) return;
            sprouts.push({
              x: nx,
              y: ny,
              rad: branch.rad + (Math.random() - 0.5) * 0.18,
              life,
            });
            if (Math.random() < (life < 6 ? 0.72 : 0.34)) {
              const fork = (Math.random() < 0.5 ? -1 : 1) * (0.35 + Math.random() * spread);
              sprouts.push({ x: nx, y: ny, rad: branch.rad + fork, life });
            }
          };

          const frame = () => {
            if (gen !== generation) return;
            let budget = reduce ? sprouts.length : 3;
            let guard = 0;
            while (sprouts.length && budget > 0 && guard < 80) {
              guard += 1;
              const branch = sprouts.shift();
              if (!branch) break;
              if (!reduce && Math.random() < 0.45) {
                sprouts.push(branch);
                continue;
              }
              step(branch);
              budget -= 1;
            }
            paint();
            if (sprouts.length) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        };

        grow();
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(grow, 180);
        });
        new MutationObserver(paint).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
    </script>
  </body>
</html>
