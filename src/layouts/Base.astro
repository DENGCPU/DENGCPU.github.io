---
import '../styles/global.css';
import { site } from '../data/site';
import TreeLogo from '../components/TreeLogo.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, wide = false, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: '首页' },
  { href: '/writing/', label: '文章' },
  { href: '/work/', label: '作品' },
  { href: '/about/', label: '关于' },
  { href: '/write/', label: '新文章' },
];

function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=2" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body class={wide ? 'wide' : undefined}>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/"><TreeLogo class="brand-logo" /><span>{site.name}</span></a>
        <div class="nav-group">
          <nav class="site-nav" aria-label="主导航">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <button class="theme-toggle" type="button" id="theme-toggle" aria-label="切换为深色模式">
            <svg class="when-light" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M14.6 3.1a8.4 8.4 0 1 0 6.5 13.2A7.2 7.2 0 0 1 14.6 3.1z"></path>
            </svg>
            <svg class="when-dark" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.4" fill="currentColor"></circle>
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2"></path>
                <path d="M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"></path>
              </g>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <a href="/write/">新文章</a>
        <span aria-hidden="true"> · </span>
        <a href={site.about.github}>{site.name}</a>
      </div>
    </footer>
    <script>
      const button = document.getElementById('theme-toggle');
      const syncLabel = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        button?.setAttribute('aria-label', dark ? '切换为浅色模式' : '切换为深色模式');
      };
      syncLabel();
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncLabel();
      });
    </script>
  </body>
</html>
